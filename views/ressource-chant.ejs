<%# Chanson pédagogique + quiz de la leçon (une question à la fois, note sur N,
    correction commentée, écran final Je maîtrise / À revoir).
    Locals : chant (data/chants.js), quiz (questions envoyées au navigateur : toute la banque,
    ou les seules questions d'essai), acces ('libre' | 'admin' | 'achat' | 'essai'), mediaType,
    mediaUrl, ressourceId, ressourceTitre, telechargementPayant (clip de la banque à téléchargement
    payant : lecteur protégé + bouton vers le paiement), clipPaye (ce visiteur a payé le clip :
    téléchargement par son lien personnel, sans nouvelle invitation à payer), attente (identifiant
    de la ressource dont le paiement, déclaré depuis ce navigateur, est en vérification : bandeau
    et actualisation automatique dès la validation — public/js/ressources-paiement.js), paiement,
    prefill, verrou.
    Essai (clip payant, pas encore acheté) : quelques questions tirées au sort, puis
    invitation à payer — le paiement débloque le quiz complet et le téléchargement. %>
<section class="container space space--narrow">
  <div class="space__head">
    <div>
      <span class="badge badge--soft"><%= chant.discipline %> · <%= chant.niveau %> · Chant <%= chant.numero %></span>
      <h1 class="space__title" style="margin-top:6px;">🎵 <%= chant.titre %></h1>
      <p class="space__sub">Leçon : <strong><%= chant.lecon %></strong></p>
    </div>
    <a href="/ressources" class="btn btn--ghost btn--sm">← Banque de ressources</a>
  </div>

  <!-- 1. La chanson (clip vidéo ou audio — le média peut venir de la banque ;
       sa lecture compte alors comme une consultation de la ressource) -->
  <div class="panel" id="chantMedia"<% if (ressourceId) { %> data-ressource-id="<%= ressourceId %>"<% } %>>
    <% if (mediaType === 'video') { %>
      <h2 style="font-family: var(--font-title); font-size: 19px; margin: 0 0 10px;">1️⃣ Regarde le clip de la chanson</h2>
      <p class="muted" style="margin: 0 0 10px;">Regarde-le autant de fois que tu veux — il contient toutes les réponses du quiz !</p>
      <video controls preload="metadata" src="<%= mediaUrl %>" style="width:100%; border-radius:10px; background:#000;"<% if (telechargementPayant) { %> controlslist="nodownload" data-protege<% } %>></video>
    <% } else if (mediaType === 'audio') { %>
      <h2 style="font-family: var(--font-title); font-size: 19px; margin: 0 0 10px;">1️⃣ Écoute la chanson</h2>
      <p class="muted" style="margin: 0 0 10px;">Écoute-la autant de fois que tu veux — elle contient toutes les réponses du quiz !</p>
      <audio controls preload="metadata" src="<%= mediaUrl %>" style="width:100%;"<% if (telechargementPayant) { %> controlslist="nodownload" data-protege<% } %>></audio>
    <% } else { %>
      <h2 style="font-family: var(--font-title); font-size: 19px; margin: 0 0 10px;">1️⃣ La chanson arrive bientôt 🎬</h2>
      <p class="muted" style="margin: 0;">Le clip de « <%= chant.titre %> » est en préparation — en attendant, le quiz de la leçon est déjà là pour t'entraîner !</p>
    <% } %>
    <% if (mediaUrl && telechargementPayant) { %>
      <% if (clipPaye) { %>
        <%# Déjà payé : la route /telecharger renvoie vers le lien personnel (fichier, ou marche à suivre s'il a expiré) %>
        <p style="margin: 10px 0 0;"><a class="btn btn--primary btn--sm" href="/ressources/<%= ressourceId %>/telecharger" rel="nofollow">⬇️ Télécharger le clip (déjà payé)</a></p>
        <p class="muted" style="margin: 8px 0 0;">✅ Ton paiement débloque le téléchargement du clip et le quiz complet.</p>
      <% } else if (attente) { %>
        <p class="quiz-note quiz-note--attente" style="margin: 10px 0 0;" data-attente-paiement="<%= attente %>">⏳ Paiement déclaré, en cours de vérification :
          le téléchargement du clip se débloquera ici tout seul.</p>
      <% } else { %>
        <p style="margin: 10px 0 0;"><a class="btn btn--ghost btn--sm" href="/ressources/<%= ressourceId %>/telecharger" rel="nofollow"
          data-paiement="<%= ressourceId %>" data-titre="<%= ressourceTitre %>">⬇️ Télécharger le clip
          <span class="ress-carte__taille">(<%= paiement.prix.toLocaleString('fr-FR') %> FCFA ≈ <%= paiement.euros %>)</span></a></p>
      <% } %>
    <% } %>
  </div>

  <% if (verrou) { %>
  <!-- 2. Quiz en pause : une compétition en cours utilise cette leçon -->
  <div class="panel">
    <h2 style="font-family: var(--font-title); font-size: 19px; margin: 0 0 6px;">2️⃣ Quiz en pause pendant la compétition 🏆</h2>
    <p class="muted" style="margin:0 0 10px;">Cette leçon fait partie des épreuves de la compétition <strong>« <%= verrou.titre %> »</strong>, en cours en ce moment.
      Le quiz d'entraînement et sa correction reviendront <%= verrou.finAt ? 'le ' + formatDate(verrou.finAt) : 'à la fin de la compétition' %>.</p>
    <a href="/competitions/<%= verrou.slug %>" class="btn btn--primary btn--sm">🏆 Participer à la compétition</a>
  </div>
</section>
  <% } else { %>
  <!-- 2. Le quiz : une question à la fois -->
  <div class="panel">
    <h2 style="font-family: var(--font-title); font-size: 19px; margin: 0 0 4px;">2️⃣ Teste-toi : le quiz de la leçon
      <button type="button" class="tts-btn tts-btn--inline" data-tts-target="#quizConsigne" aria-label="Écouter la consigne">🔊</button></h2>
    <%# Un test = au plus 10 questions tirées au sort dans la banque de la leçon ;
        essai (clip payant pas encore acheté) : les seules questions d'essai reçues %>
    <% var essai = acces === 'essai'; var tailleTest = essai ? quiz.length : 10; var nbTest = Math.min(tailleTest, quiz.length);
       var nbComplet = Math.min(10, chant.quiz.length); var prixFr = paiement.prix.toLocaleString('fr-FR'); %>
    <% if (essai) { %>
      <p class="muted" id="quizConsigne" style="margin: 0 0 12px;">Quiz d'essai : <%= nbTest %> questions tirées au sort parmi les <%= chant.quiz.length %> de la leçon. Réponds, appuie sur « Vérifier » et lis la correction.
        Un seul paiement de <%= prixFr %> FCFA débloque le quiz complet (<%= nbComplet %> questions à chaque tentative) et le téléchargement du clip.</p>
      <%# Hors de la consigne lue à voix haute %>
      <% if (attente) { %>
        <%# Paiement déclaré depuis cet appareil : la page s'actualise d'elle-même dès la validation %>
        <p class="quiz-note quiz-note--attente" id="quizDejaPaye" role="status" data-attente-paiement="<%= attente %>">⏳ <strong>Paiement déclaré : vérification en cours</strong>
          (moins de <%= paiement.delaiHeures %> heures). Garde cette page ouverte ou reviens plus tard : dès que le paiement est validé, elle s'actualise d'elle-même
          et donne accès au quiz complet et au téléchargement du clip — même si le lien part à l'adresse e-mail d'un parent.</p>
      <% } else { %>
        <p class="quiz-note" id="quizDejaPaye">💳 <strong>Déjà payé ?</strong> L'appareil sur lequel le paiement a été déclaré se débloque tout seul dès la validation.
          Paiement déclaré sur un autre appareil ? Ouvre ici le lien reçu par e-mail (même s'il a expiré), ou connecte-toi avec le compte de l'adresse e-mail utilisée pour payer.
          Lien perdu ? <a href="mailto:<%= APP.contact.email %>"><%= APP.contact.email %></a> · <%= APP.contact.phone %> (WhatsApp).</p>
      <% } %>
    <% } else { %>
      <p class="muted" id="quizConsigne" style="margin: 0 0 12px;">Une question à la fois : réponds, appuie sur « Vérifier », lis la correction, puis passe à la suivante. Note finale sur <%= nbTest %>.<% if (quiz.length > nbTest) { %> Les <%= nbTest %> questions sont tirées au sort parmi les <%= quiz.length %> de la leçon : chaque tentative est différente.<% } %></p>
    <% } %>
    <% if (acces === 'admin') { %>
      <p class="quiz-note">👑 Mode administrateur : le quiz complet s'affiche. Les visiteurs qui n'ont pas payé le clip n'en font que <%= paiement.questionsEssai %> questions d'essai.</p>
    <% } else if (acces === 'achat') { %>
      <p class="quiz-note quiz-note--ok">✅ Quiz complet débloqué grâce à ton paiement.</p>
    <% } %>

    <div class="quiz-progression" id="quizProgression">
      <span id="quizEtape">Question 1 / <%= nbTest %></span>
      <div class="quiz-barre"><div class="quiz-barre__remplie" id="quizBarre" style="width: <%= Math.round(100 / nbTest) %>%;"></div></div>
    </div>

    <% quiz.forEach(function(q, i){ %>
      <div class="quiz-q" data-i="<%= i %>" data-type="<%= q.type %>" <%= i === 0 ? '' : 'hidden' %>>
        <p class="quiz-q__enonce"><strong>Q<%= i + 1 %>.</strong> <%= q.question %>
          <% if (q.type === 'qcm') { %><span class="badge badge--soft">plusieurs réponses</span><% } %>
          <% if (q.type === 'classement') { %><span class="badge badge--soft">clique dans l'ordre</span><% } %>
          <button type="button" class="tts-btn tts-btn--inline quiz-q__ecouter" aria-label="Écouter la question">🔊</button></p>
        <% if (q.image) { %>
          <%# ?v= : l'adresse change avec le contenu du fichier (sinon le cache navigateur / service worker garde l'ancien dessin) %>
          <img class="quiz-q__image" src="<%= q.image %>?v=<%= v(q.image.replace(/^\//, '')) %>" alt="<%= q.imageAlt || '' %>" loading="lazy">
        <% } %>

        <% if (q.type === 'qcu') { %>
          <div class="fniv-radio">
            <% q.options.forEach(function(opt, j){ %>
              <label class="check-pill"><input type="radio" name="q<%= i %>" value="<%= j %>"><span><%= opt %></span></label>
            <% }) %>
          </div>
        <% } else if (q.type === 'qcm') { %>
          <div class="fniv-radio">
            <% q.options.forEach(function(opt, j){ %>
              <label class="check-pill"><input type="checkbox" name="q<%= i %>" value="<%= j %>"><span><%= opt %></span></label>
            <% }) %>
          </div>
        <% } else if (q.type === 'vraifaux') { %>
          <div class="fniv-radio">
            <label class="check-pill"><input type="radio" name="q<%= i %>" value="vrai"><span>✅ Vrai</span></label>
            <label class="check-pill"><input type="radio" name="q<%= i %>" value="faux"><span>❌ Faux</span></label>
          </div>
        <% } else if (q.type === 'classement') { %>
          <div class="classement">
            <div class="classement__items">
              <% q.items.forEach(function(item, j){ %>
                <button type="button" class="classement__item" data-j="<%= j %>"><span class="classement__rang" hidden></span><%= item %></button>
              <% }) %>
            </div>
            <button type="button" class="btn btn--ghost btn--sm classement__reset">↺ Refaire l'ordre</button>
          </div>
        <% } else { %>
          <input type="text" name="q<%= i %>" maxlength="200" placeholder="Écris ta réponse ici…" autocomplete="off" style="width:100%;">
        <% } %>

        <div class="quiz-q__pied">
          <button type="button" class="btn btn--ghost btn--sm quiz-q__prec" hidden>← Précédente</button>
          <button type="button" class="btn btn--primary btn--sm quiz-q__verifier">Vérifier</button>
          <button type="button" class="btn btn--ghost btn--sm quiz-q__suivante" hidden><%= i === quiz.length - 1 ? '🏁 Voir mon résultat' : 'Question suivante →' %></button>
        </div>
        <div class="quiz-q__feedback" hidden></div>
        <div class="quiz-q__commentaire" hidden></div>
      </div>
    <% }) %>

    <!-- 3. Écran final : Je maîtrise / À revoir -->
    <div class="quiz-bilan" id="quizBilan" hidden>
      <h3 class="quiz-bilan__titre"></h3>
      <p class="quiz-bilan__note"></p>
      <p class="quiz-bilan__texte"></p>
      <div class="quiz-bilan__actions">
        <% if (essai && !attente) { %>
          <a class="btn btn--primary btn--sm" href="/ressources/<%= ressourceId %>/telecharger" rel="nofollow"
             data-paiement="<%= ressourceId %>" data-titre="<%= ressourceTitre %>">🔓 Quiz complet + téléchargement — <%= prixFr %> FCFA</a>
        <% } %>
        <% if (mediaUrl) { %>
          <button type="button" class="btn btn--amber btn--sm" id="quizReecouter">🔊 Réécouter la chanson</button>
        <% } %>
        <button type="button" class="btn btn--ghost btn--sm" id="quizRecommencer"><%= essai ? '🔄 Refaire l’essai' : '🔄 Recommencer le quiz' %></button>
        <a href="/ressources" class="btn btn--ghost btn--sm">📚 Autres ressources</a>
      </div>
      <% if (essai && attente) { %>
        <p class="quiz-note quiz-note--attente" style="margin: 10px 0 0;" data-attente-paiement="<%= attente %>">⏳ Ton paiement est en cours de vérification :
          cette page se débloquera toute seule (quiz complet et téléchargement du clip).</p>
      <% } else if (essai) { %>
        <p class="muted" style="margin: 8px 0 0; font-size: 13px;">Déjà payé ? L'appareil qui a déclaré le paiement se débloque tout seul ; sinon, ouvre ici le lien reçu par e-mail (<a href="#quizDejaPaye">détails</a>).</p>
      <% } %>
    </div>
  </div>
</section>

<script>
  // Corrigé du quiz (comparé côté navigateur — quiz d'entraînement) ; en essai,
  // seules les questions d'essai y figurent.
  window.CHANT_QUIZ = <%- JSON.stringify({
    lecon: chant.lecon,
    tailleTest: tailleTest,
    essai: essai ? { banque: chant.quiz.length, complet: nbComplet, prix: prixFr, attente: !!attente } : null,
    questions: quiz.map(function(q){ return {
      type: q.type,
      question: q.question,
      bonne: typeof q.bonne === 'undefined' ? null : q.bonne,
      bonnes: q.bonnes || null,
      motsCles: q.motsCles || null,
      reponseAffichee: q.reponseAffichee || null,
      options: q.options || null,
      items: q.items || null,
      ordre: q.ordre || null,
      commentaire: q.commentaire || null,
    }; }),
  }).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/formation-tts.js?v=<%= v('js/formation-tts.js') %>" defer></script>
<script src="/js/chant-quiz.js?v=<%= v('js/chant-quiz.js') %>" defer></script>
  <% } %>
<script src="/js/ressources-stats.js?v=<%= v('js/ressources-stats.js') %>" defer></script>
<% if (telechargementPayant) { %>
<%- include('partials/modal-paiement', { titre: '🔓 Débloquer' }) %>
<script src="/js/ressources-paiement.js?v=<%= v('js/ressources-paiement.js') %>" defer></script>
<% } %>
