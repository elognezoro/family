<%# Lien personnel de téléchargement (envoyé par e-mail après vérification du paiement).
    Locals : achat (avec sa ressource) ou null, etat ('ok' | 'expire' | 'indisponible' | 'invalide'), formatDate %>
<section class="container space space--narrow">
  <div class="space__head">
    <div>
      <h1 class="space__title">⬇️ Votre téléchargement</h1>
      <% if (achat) { %><p class="space__sub">« <%= achat.titreRessource %> »</p><% } %>
    </div>
    <a href="/ressources" class="btn btn--ghost btn--sm">← Banque de ressources</a>
  </div>

  <div class="panel">
    <% if (etat === 'ok') { %>
      <p style="margin-top:0;">✅ Merci pour votre paiement ! Votre fichier est prêt.</p>
      <a class="btn btn--primary btn--lg" href="/ressources/telechargement/<%= achat.jeton %>/fichier" rel="nofollow">⬇️ Télécharger<% if (achat.ressource.taille) { %> (<%= achat.ressource.taille >= 1048576 ? (achat.ressource.taille / 1048576).toFixed(1).replace('.', ',') + ' Mo' : Math.max(1, Math.round(achat.ressource.taille / 1024)) + ' Ko' %>)<% } %></a>
      <p class="muted" style="margin-bottom:0;">Ce lien personnel est valable jusqu'au <strong><%= formatDate(achat.expireAt) %></strong> (heure d'Abidjan).
        Sur téléphone, le fichier arrive dans le dossier « Téléchargements ».</p>
    <% } else if (etat === 'expire') { %>
      <p style="margin-top:0;">⌛ Ce lien de téléchargement a expiré.</p>
      <p class="muted" style="margin-bottom:0;">Écrivez-nous à <a href="mailto:<%= APP.contact.email %>"><%= APP.contact.email %></a>
        ou appelez le <%= APP.contact.phone %> (WhatsApp) en indiquant votre e-mail : nous vous renverrons un lien.</p>
    <% } else if (etat === 'indisponible') { %>
      <p style="margin-top:0;">Cette ressource n'est plus disponible pour le moment.</p>
      <p class="muted" style="margin-bottom:0;">Contactez-nous à <a href="mailto:<%= APP.contact.email %>"><%= APP.contact.email %></a>
        ou au <%= APP.contact.phone %> (WhatsApp).</p>
    <% } else { %>
      <p style="margin-top:0;">Ce lien de téléchargement n'est pas valide.</p>
      <p class="muted" style="margin-bottom:0;">Vérifiez que vous avez copié l'adresse en entier depuis l'e-mail reçu. Un souci ?
        Écrivez-nous à <a href="mailto:<%= APP.contact.email %>"><%= APP.contact.email %></a> ou appelez le <%= APP.contact.phone %> (WhatsApp).</p>
    <% } %>
  </div>
</section>
