<div class="auth-wrap">
  <a href="/auth/login" class="auth-back"><%- icon('home', 16) %> <%= t('auth.backToLogin') %></a>
  <div class="auth-card">
    <div class="auth-logo">
      <div class="auth-logo__halo"></div>
      <img src="/images/logo.svg" alt="EduWeb" onerror="this.outerHTML='<div class=\'auth-logo__fallback\'>Edu<span>Web</span></div>'">
    </div>
    <h1 class="auth-title"><%= t('auth.forgotTitle') %></h1>
    <p class="auth-sub"><%= t('auth.forgotSub') %></p>

    <form action="/auth/forgot" method="POST" class="form">
      <div class="field">
        <label for="email"><%= t('auth.email') %></label>
        <input type="email" id="email" name="email" required placeholder="vous@exemple.ci" autocomplete="email">
      </div>
      <button type="submit" class="btn btn--primary btn--block btn--lg"><%= t('auth.forgotBtn') %></button>
    </form>

    <p class="auth-foot"><a href="/auth/login"><%= t('auth.backToLogin') %></a></p>
  </div>
</div>
