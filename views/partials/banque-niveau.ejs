<%# Un accordéon de niveau de la banque : un accordéon par discipline, ressources dans chaque discipline.
    Locals : n (niveau), groupe (nom commun des accordéons du même rang : ouvrir l’un referme
    les autres), rangNiv (position du niveau, pour grouper ses accordéons de discipline et « Auteurs »),
    chantDe, auteursDe, nombreFr, paiement, ressourcesPayees (facultatif : ressources déjà payées
    par ce visiteur — téléchargement sans nouvelle invitation à payer), ressourcesEnAttente (facultatif :
    paiement déclaré depuis ce navigateur, en vérification — la carte se débloque d'elle-même) (hérités de la page).
    Ressource à téléchargement payant : « Télécharger » ouvre l'invitation à payer
    (public/js/ressources-paiement.js) — l'adresse du fichier n'y figure jamais —, et le
    lecteur n'offre ni menu « Télécharger », ni clic droit, ni ouverture du fichier brut. %>
<details class="niv-acc" name="<%= groupe %>">
  <summary class="niv-acc__resume">
    <span class="niv-acc__nom">🎓 <%= n.niveau %></span>
    <span class="niv-acc__compte"><%= n.total %> ressource<%= n.total > 1 ? 's' : '' %> · <%= n.disciplines.length %> discipline<%= n.disciplines.length > 1 ? 's' : '' %></span>
    <span class="niv-acc__chevron">▾</span>
  </summary>
  <%# Disciplines du niveau : accordéons repliés, empilés ; ouvrir l’une referme les autres du niveau %>
  <div class="disc-liste">
    <% n.disciplines.forEach(function(d){ %>
      <details class="disc-acc" name="<%= groupe %>-disc-<%= rangNiv %>">
        <summary class="disc-acc__resume">
          <span class="disc-acc__nom">📘 <%= d.nom %></span>
          <span class="badge badge--soft"><%= d.ressources.length %></span>
          <span class="disc-acc__compte"><%= d.ressources.length > 1 ? 'ressources' : 'ressource' %></span>
          <span class="disc-acc__chevron">▾</span>
        </summary>
        <div class="disc-acc__corps">
        <%# Auteurs de la discipline (replié par défaut), entre le titre et le premier contenu %>
        <% var auteurs = auteursDe(d.nom, n.niveau); %>
        <% if (auteurs) { %>
          <details class="auteurs-acc" name="<%= groupe %>-auteurs-<%= rangNiv %>">
            <summary class="auteurs-acc__resume">✍️ Auteurs <span class="badge badge--soft"><%= auteurs.liste.length %></span><span class="auteurs-acc__chevron">▾</span></summary>
            <div class="auteurs-acc__corps">
              <p class="auteurs-acc__titre"><%= auteurs.titre %></p>
              <ul class="auteurs-acc__liste">
                <% auteurs.liste.forEach(function(a){ %><li><%= a %></li><% }) %>
              </ul>
            </div>
          </details>
        <% } %>
        <div class="disc-tuile__liste">
        <% d.ressources.forEach(function(r){
             var mime = r.mime || '';
             var estVideo = mime.startsWith('video'), estAudio = mime.startsWith('audio');
             var lienTelechargement = r.url + (r.url.indexOf('?') >= 0 ? '&' : '?') + 'download=1';
             var taille = !r.taille ? '' : r.taille >= 1048576 ? (r.taille / 1048576).toFixed(1).replace('.', ',') + ' Mo' : Math.max(1, Math.round(r.taille / 1024)) + ' Ko';
             var vues = r.vues || 0, telechargements = r.telechargements || 0;
             var payant = r.type === 'fichier' && r.telechargementPayant;
             var dejaPaye = payant && (locals.ressourcesPayees || []).indexOf(r.id) !== -1;
             var enAttente = payant && !dejaPaye && (locals.ressourcesEnAttente || []).indexOf(r.id) !== -1;
             var tailleEtPrix = [taille, payant ? paiement.prix.toLocaleString('fr-FR') + ' FCFA' : ''].filter(Boolean).join(' · '); %>
          <div class="ress-carte ress-carte--tuile" data-ressource-id="<%= r.id %>">
      <h3 class="ress-carte__titre">
        <%= r.type === 'lien' ? '🔗' : estVideo ? '🎬' : estAudio ? '🎧' : mime.includes('pdf') ? '📄' : mime.startsWith('image') ? '🖼️' : '📁' %>
        <%= r.titre %>
      </h3>
      <% if (r.description) { %><p class="muted ress-carte__desc"><%= r.description %></p><% } %>
      <% if (estAudio) { %>
        <audio controls preload="none" src="<%= r.url %>" style="width:100%;"<% if (payant) { %> controlslist="nodownload" data-protege<% } %>></audio>
      <% } %>
      <% if (estVideo) { %>
        <video controls preload="metadata" src="<%= r.url %>" style="width:100%; border-radius:8px; background:#000;"<% if (payant) { %> controlslist="nodownload" data-protege<% } %>></video>
      <% } %>
      <div class="ress-carte__actions">
        <% if (r.type === 'lien') { %>
          <a class="btn btn--primary btn--sm" href="<%= r.url %>" target="_blank" rel="noopener" data-stat="vue">Ouvrir</a>
        <% } else if (payant) { %>
          <% if (estVideo) { %>
            <button type="button" class="btn btn--primary btn--sm" data-plein-ecran data-stat="vue">Plein écran</button>
          <% } %>
          <% if (dejaPaye) { %>
            <%# Déjà payé : la route /telecharger renvoie vers le lien personnel %>
            <a class="btn <%= estVideo ? 'btn--ghost' : 'btn--primary' %> btn--sm" href="/ressources/<%= r.id %>/telecharger" rel="nofollow">⬇️ Télécharger (déjà payé)</a>
          <% } else if (enAttente) { %>
            <%# Paiement déclaré d'ici : pas de second paiement ; la carte s'actualise dès la validation %>
            <span class="ress-carte__attente" data-attente-paiement="<%= r.id %>">⏳ Paiement en vérification</span>
          <% } else { %>
          <a class="btn <%= estVideo ? 'btn--ghost' : 'btn--primary' %> btn--sm" href="/ressources/<%= r.id %>/telecharger" rel="nofollow"
             data-paiement="<%= r.id %>" data-titre="<%= r.titre %>">⬇️ Télécharger <span class="ress-carte__taille">(<%= tailleEtPrix %>)</span></a>
          <% } %>
        <% } else if (estVideo) { %>
          <a class="btn btn--primary btn--sm" href="<%= r.url %>" target="_blank" rel="noopener" data-stat="vue">Plein écran</a>
          <a class="btn btn--ghost btn--sm" href="<%= lienTelechargement %>" download data-stat="telechargement">⬇️ Télécharger<% if (taille) { %> <span class="ress-carte__taille">(<%= taille %>)</span><% } %></a>
        <% } else if (estAudio) { %>
          <a class="btn btn--primary btn--sm" href="<%= lienTelechargement %>" download data-stat="telechargement">⬇️ Télécharger<% if (taille) { %> <span class="ress-carte__taille">(<%= taille %>)</span><% } %></a>
        <% } else { %>
          <a class="btn btn--primary btn--sm" href="<%= r.url %>" target="_blank" rel="noopener" data-stat="telechargement">Télécharger<% if (taille) { %> <span class="ress-carte__taille">(<%= taille %>)</span><% } %></a>
        <% } %>
        <% var chant = chantDe(r); %>
        <% if (chant) { %>
          <a class="btn btn--amber btn--sm" href="/ressources/chants/<%= chant.slug %>">🎯 Chanson &amp; évaluation</a>
        <% } %>
          </div>
          <%# Compteurs de fréquentation de la ressource (mis à jour par ressources-stats.js) %>
          <p class="ress-carte__stats">
            <span title="Lectures et ouvertures de cette ressource">👁️
              <b data-stat-val="vue" data-n="<%= vues %>"><%= nombreFr(vues) %></b>
              <span data-stat-lib="vue" data-singulier="consultation" data-pluriel="consultations"><%= vues > 1 ? 'consultations' : 'consultation' %></span></span>
            <% if (r.type !== 'lien') { %>
              <span title="Téléchargements de cette ressource">⬇️
                <b data-stat-val="telechargement" data-n="<%= telechargements %>"><%= nombreFr(telechargements) %></b>
                <span data-stat-lib="telechargement" data-singulier="téléchargement" data-pluriel="téléchargements"><%= telechargements > 1 ? 'téléchargements' : 'téléchargement' %></span></span>
            <% } %>
          </p>
          </div>
        <% }) %>
        </div>
        </div>
      </details>
    <% }) %>
  </div>
</details>
