<section class="container space">
  <div class="space__head">
    <div>
      <h1 class="space__title"><%- icon('award', 26) %> Préparation aux concours</h1>
      <p class="space__sub">Deux parcours complets : <strong>Tests psychotechniques</strong> et <strong>Statut général de la Fonction Publique</strong> — exercices corrigés, astuces d’experts, diagnostic personnalisé par IA.</p>
    </div>
    <% if (currentUser) { %><a href="/<%= currentUser.role %>" class="btn btn--ghost btn--sm">← Mon espace</a><% } %>
  </div>

  <!-- Présentation -->
  <div class="panel formation-hero">
    <div class="formation-hero__body">
      <h2>Réussir son concours, ça se prépare <em>méthodiquement</em>.</h2>
      <p id="fPitch">
        Un concours se gagne sur <strong>deux terrains</strong> : les <strong>épreuves d’aptitude</strong> — les tests
        psychotechniques (logique, calcul, vocabulaire, attention, organisation, mémoire, personnalité) — et les
        <strong>épreuves de connaissances</strong> — comme le <strong>Statut général de la Fonction Publique</strong>,
        incontournable des concours administratifs. Qu’il s’agisse des concours d’instituteurs adjoints, de personnel
        de santé ou d’accès à la Fonction Publique, beaucoup de candidats échouent non par manque d’intelligence,
        mais par manque d’entraînement méthodique. EduWeb vous prépare pas à pas sur les deux terrains :
        le cours et la théorie expliqués simplement, plus d’un millier d’exercices corrigés, des astuces d’experts,
        et après chaque test un <strong>diagnostic de vos points forts et de vos points à travailler</strong>,
        avec des conseils d’orientation adaptés à votre profil.
      </p>
      <button type="button" class="btn btn--ghost btn--sm tts-btn" data-tts-target="#fPitch">🔊 Écouter</button>
      <div class="formation-hero__stats">
        <div><strong><%= (totalQuestions || 0) + (typeof totalFp !== 'undefined' ? totalFp : 0) %></strong><span>exercices dans la banque</span></div>
        <div><strong>2</strong><span>parcours de préparation</span></div>
        <div><strong>7 + 15</strong><span>catégories &amp; séquences de cours</span></div>
        <div><strong>5</strong><span>paliers : Débutant → Simulation</span></div>
      </div>
    </div>
  </div>

  <!-- ═══ LES DEUX SOUS-RUBRIQUES ═══ -->
  <h2 class="section-title">Choisissez votre parcours</h2>
  <div class="fdomaines">
    <div class="panel fdomaine" style="--cat: #1E9E57">
      <div class="fdomaine__tete"><span class="fdomaine__emoji">🧠</span>
        <div><h3>Tests psychotechniques</h3>
        <p class="muted">Logique, calcul, vocabulaire, attention, organisation, mémoire, personnalité — <%= totalQuestions %> questions corrigées, 3 niveaux (avant-BEPC, BEPC, BAC+), entraînement et conditions de concours.</p></div>
      </div>
      <% if (approved) { %>
        <div class="fdomaine__actions">
          <a class="btn btn--primary btn--sm" href="/formation/psychotechniques"><%- icon('award', 15) %> Ouvrir le module</a>
        </div>
      <% } else { %>
        <span class="badge badge--soft">Inclus dans l'accès Préparation aux concours</span>
      <% } %>
    </div>
    <div class="panel fdomaine" style="--cat: #B45309">
      <div class="fdomaine__tete"><span class="fdomaine__emoji">⚖️</span>
        <div><h3>Statut général de la Fonction Publique</h3>
        <p class="muted">La loi n° 2023-892 maîtrisée article par article : 15 séquences de cours audio, <%= typeof totalFp !== 'undefined' && totalFp ? totalFp : '580' %> exercices variés (cas pratiques, pièges, multi-réponses, associations, classements) et un parcours Débutant → Intermédiaire → Avancé → Expert → <strong>Simulation Concours</strong>.</p></div>
      </div>
      <% if (approved) { %>
        <div class="fdomaine__actions">
          <a class="btn btn--primary btn--sm" href="/formation/fonction-publique"><%- icon('shield', 15) %> Ouvrir le module</a>
        </div>
      <% } else { %>
        <span class="badge badge--soft">Inclus dans l'accès Préparation aux concours</span>
      <% } %>
    </div>
  </div>

  <% if (typeof promoPrefill !== 'undefined' && promoPrefill) { %>
    <div class="info-banner">🎟️ Le code promo <strong><%= promoPrefill.code %></strong> (−<%= promoPrefill.pct %> %) sera appliqué à votre formule<%= currentUser ? ' — il est déjà rempli dans le formulaire ci-dessous' : ' — créez votre compte pour en profiter' %>.</div>
  <% } %>

  <%# §19 — information transparente du filleul, AVANT le paiement %>
  <% if (typeof infoParrainage !== 'undefined' && infoParrainage) { %>
    <% if (infoParrainage.placeDisponible) { %>
      <div class="info-banner">🎁 <strong>Bonne nouvelle :</strong> le code de parrainage utilisé à votre inscription vous donne droit à
        <strong><%= infoParrainage.tauxReduction %> % de réduction</strong> sur votre formule — appliquée automatiquement quand vous déclarerez votre paiement.</div>
    <% } else { %>
      <div class="info-banner">ℹ️ Les avantages promotionnels du lien qui vous a invité ont déjà tous été attribués :
        votre abonnement est au tarif normal. Après votre abonnement, vous disposerez de <strong>votre propre lien de parrainage</strong>
        et pourrez gagner des rétrocessions grâce à vos propres filleuls.</div>
    <% } %>
  <% } %>

  <!-- Statut d'inscription / actions -->
  <% if (!currentUser) { %>
    <% if (offres && offres.length) { %>
      <h2 class="section-title">Nos formules d’accès</h2>
      <div class="foffre-grid">
        <% offres.forEach(function(o){ %>
          <div class="panel foffre-card">
            <strong class="foffre-pick__nom"><%= o.nom %></strong>
            <span class="foffre-pick__prix"><%= APP.formatFCFA(o.prix) %></span>
            <small class="muted"><%= o.dureeJours ? o.dureeJours + ' jours d’accès' : 'Durée illimitée' %> · <%= o.quotaTentatives ? o.quotaTentatives + ' tests' : 'tests illimités' %></small>
            <% if (o.description) { %><small class="muted"><%= o.description %></small><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
    <% if (typeof refInvite !== 'undefined' && refInvite) { %>
      <div class="info-banner">🤝 <strong><%= refInvite.parrainNom %></strong> vous invite à préparer vos concours sur EduWeb.
        En créant votre compte avec ce lien, vous devenez son filleul : si une place promotionnelle est disponible,
        une <strong>réduction de bienvenue</strong> s’appliquera à votre formule.</div>
    <% } %>
    <% var urlInscription = '/auth/register?role=candidat' + (typeof refInvite !== 'undefined' && refInvite ? '&ref=' + encodeURIComponent(refInvite.code) : ''); %>
    <div class="panel formation-cta">
      <h3>Comment obtenir l’accès ?</h3>
      <p id="fComment">L’accès à la Formation est réservé : créez votre compte EduWeb (le rôle « Candidat Tests
      Psychotechniques » vous est proposé), puis payez une formule (par Wave, Orange Money, MTN MoMo ou Moov Money)
      ou demandez une autorisation à l’administrateur. Votre accès est activé après vérification — vous êtes prévenu par e-mail.</p>
      <div class="formation-cta__btns">
        <a class="btn btn--primary" href="<%= urlInscription %>">Créer mon compte Candidat</a>
        <a class="btn btn--ghost" href="/auth/login">J’ai déjà un compte</a>
        <button type="button" class="btn btn--ghost btn--sm tts-btn" data-tts-target="#fComment">🔊 Écouter</button>
      </div>
    </div>
  <% } else if (approved) { %>
    <div class="panel formation-actions">
      <a class="btn btn--ghost" href="/formation/historique"><%- icon('doc', 18) %> Mes résultats (tous parcours)</a>
      <% if (enrollment && enrollment.expiresAt) { %>
        <span class="badge badge--soft">Accès jusqu’au <%= new Date(enrollment.expiresAt).toLocaleDateString('fr-FR') %></span>
      <% } %>
      <% if (quotaRestant !== null && quotaRestant !== undefined) { %>
        <span class="badge <%= quotaRestant > 3 ? 'badge--ok' : 'badge--no' %>"><%= quotaRestant %> test<%= quotaRestant > 1 ? 's' : '' %> restant<%= quotaRestant > 1 ? 's' : '' %></span>
      <% } %>
    </div>
  <% } else if (enrollment && enrollment.statut === 'pending') { %>
    <div class="info-banner"><%- icon('clock', 16) %>
      <% if (enrollment.accessType === 'paye') { %>
        Votre paiement déclaré<%= enrollment.montantAttendu ? ' de ' + APP.formatFCFA(enrollment.montantAttendu) : '' %>
        (réf. <%= enrollment.refTransaction %>, <%= enrollment.operateur %>) est <strong>en cours de vérification</strong> par un administrateur.
        Vous recevrez un e-mail dès l’activation de votre accès.
      <% } else { %>
        Votre demande d’autorisation est <strong>en attente d’examen</strong> par un administrateur. Vous recevrez un e-mail dès qu’elle sera traitée.
      <% } %>
    </div>
  <% } else if (enrollment && enrollment.statut === 'approuve' && expire) { %>
    <div class="panel">
      <div class="info-banner info-banner--warn"><%- icon('clock', 16) %> Votre accès a <strong>expiré</strong> le <%= new Date(enrollment.expiresAt).toLocaleDateString('fr-FR') %>. Renouvelez une formule pour continuer votre préparation (votre historique est conservé).</div>
      <%- include('inscription-form', { niveaux, enrollment }) %>
    </div>
  <% } else if (enrollment && enrollment.statut === 'refuse') { %>
    <div class="panel">
      <div class="info-banner info-banner--warn"><%- icon('x', 16) %> Votre demande n’a pas été validée<%= enrollment.motifRefus ? ' — motif : ' + enrollment.motifRefus : '' %>. Vous pouvez soumettre une nouvelle demande.</div>
      <%- include('inscription-form', { niveaux, enrollment }) %>
    </div>
  <% } else { %>
    <div class="panel">
      <h3><%- icon('edit', 20) %> Obtenir mon accès</h3>
      <p class="muted" id="fInscr">L’accès aux tests est réservé aux candidats ayant payé une formule ou autorisés par l’administrateur.
        Choisissez votre voie ci-dessous — vous serez prévenu par e-mail dès l’activation.
        <button type="button" class="tts-btn tts-btn--inline" data-tts-target="#fInscr" aria-label="Écouter">🔊</button></p>
      <%- include('inscription-form', { niveaux, enrollment: null }) %>
    </div>
  <% } %>

  <!-- Présentation générale (visiteurs et non-inscrits) — la progression de
       chaque parcours vit désormais DANS son module -->
  <% if (!approved) { %>
    <h2 class="section-title">Ce que couvrent les deux parcours</h2>
    <div class="fniv-grid">
      <div class="panel fniv-card">
        <h3>🧠 Épreuves d'aptitude</h3>
        <span class="badge badge--soft">Tests psychotechniques</span>
        <p class="muted">7 catégories (logique, calcul, vocabulaire, attention, organisation, mémoire, personnalité), 3 niveaux de concours (avant-BEPC, BEPC, BAC+), entraînement corrigé et conditions de concours chronométrées.</p>
      </div>
      <div class="panel fniv-card">
        <h3>⚖️ Épreuves de connaissances</h3>
        <span class="badge badge--soft">Statut général de la Fonction Publique</span>
        <p class="muted">La loi n° 2023-892 apprise article par article : cours audio, cas pratiques, questions-pièges, jeux d'apprentissage, révision espacée et Simulation Concours.</p>
      </div>
    </div>

    <h2 class="section-title">Pour quels concours ?</h2>
    <div class="fniv-grid">
      <% niveaux.forEach(function(n){ %>
        <div class="panel fniv-card">
          <h3><%= n.label %></h3>
          <span class="badge badge--soft"><%= n.sousTitre %></span>
          <p class="muted"><%= n.desc %></p>
        </div>
      <% }) %>
    </div>

    <h2 class="section-title">Comment ça marche ?</h2>
    <div class="panel">
      <ol class="fsteps" id="fSteps">
        <li><strong>Inscrivez-vous</strong> et obtenez votre accès (formule payée ou autorisation) : il couvre LES DEUX parcours.</li>
        <li><strong>Apprenez la méthode</strong> : fiches de théorie des tests psychotechniques, cours du Statut général article par article — avec lecture audio partout.</li>
        <li><strong>Entraînez-vous</strong> : corrections expliquées, questions mélangées à chaque tentative, difficulté croissante, jeux d'apprentissage et révision espacée.</li>
        <li><strong>Progressez</strong> : score, diagnostic de performance par IA, carte de maîtrise, puis conditions réelles de concours chronométrées.</li>
      </ol>
      <button type="button" class="btn btn--ghost btn--sm tts-btn" data-tts-target="#fSteps">🔊 Écouter les étapes</button>
    </div>
  <% } %>
</section>
<script src="/js/formation-tts.js?v=<%= v('js/formation-tts.js') %>" defer></script>
