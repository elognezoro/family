<section class="container space space--narrow">
  <div class="space__head">
    <div>
      <h1 class="space__title"><%- icon('doc', 26) %> Mes résultats</h1>
      <p class="space__sub">Toutes vos tentatives, pour suivre votre progression.</p>
    </div>
    <a href="/formation" class="btn btn--ghost btn--sm">← Formation</a>
  </div>

  <% if (!attempts.length) { %>
    <div class="panel"><div class="empty"><%- icon('edit', 36) %><p>Aucun test terminé pour l’instant. Lancez-vous !</p>
      <a class="btn btn--primary" href="/formation/tests">Passer mon premier test</a></div></div>
  <% } else { %>
    <div class="panel" style="overflow-x:auto;">
      <table class="table">
        <thead>
          <tr><th>Date</th><th>Catégorie</th><th>Niveau</th><th>Mode</th><th>Score</th><th></th></tr>
        </thead>
        <tbody>
          <% attempts.forEach(function(a){ var c = meta.categorie(a.categorie); var n = meta.niveau(a.niveau); var pct = Math.round((a.score / a.nbQuestions) * 100); %>
            <tr>
              <td><%= new Date(a.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
              <td><%= c ? c.label : a.categorie %></td>
              <td><%= n ? n.label : a.niveau %></td>
              <td><%= a.mode === 'examen' ? '⏱️ Concours' : '🎯 Entraînement' %></td>
              <td><span class="badge <%= pct >= 60 ? 'badge--ok' : 'badge--no' %>"><%= a.score %>/<%= a.nbQuestions %> (<%= pct %> %)</span></td>
              <td><a class="btn btn--ghost btn--sm" href="/formation/tests/<%= a.id %>/resultat">Voir</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
