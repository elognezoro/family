<section class="container space">
  <div class="space__head">
    <div>
      <h1 class="space__title">🧠 Tests psychotechniques</h1>
      <p class="space__sub">Les épreuves d'aptitude des concours : <%= totalQuestions %> questions corrigées, 6 catégories, 3 niveaux, entraînement et conditions de concours.</p>
    </div>
    <a href="/formation" class="btn btn--ghost btn--sm">← Préparation aux concours</a>
  </div>

  <!-- Actions -->
  <div class="panel formation-actions">
    <a class="btn btn--primary" href="/formation/tests"><%- icon('edit', 18) %> Passer un test</a>
    <a class="btn btn--ghost" href="/formation/theorie"><%- icon('book', 18) %> Théorie &amp; astuces</a>
    <a class="btn btn--ghost" href="/formation/historique"><%- icon('doc', 18) %> Mes résultats</a>
  </div>

  <!-- Progression par catégorie -->
  <h2 class="section-title">Ma progression par catégorie</h2>
  <div class="fcat-grid">
    <% categories.forEach(function(c){ var p = progression[c.id] || { tentatives: 0, meilleurExamen: null, meilleurEntrainement: null }; %>
      <div class="panel fcat-card" style="--cat: <%= c.couleur %>">
        <div class="fcat-card__icon"><%- icon(c.icon, 24) %></div>
        <h3><%= c.label %></h3>
        <p class="muted"><%= c.desc %></p>
        <div class="fcat-card__meta">
          <span class="badge badge--soft"><%= p.tentatives %> test<%= p.tentatives > 1 ? 's' : '' %></span>
          <% if (p.meilleurExamen !== null) { %><span class="badge <%= p.meilleurExamen >= 60 ? 'badge--ok' : 'badge--no' %>">⏱️ Concours : <%= p.meilleurExamen %> %</span><% } %>
          <% if (p.meilleurEntrainement !== null) { %><span class="badge badge--soft">🎯 Entraînement : <%= p.meilleurEntrainement %> %</span><% } %>
        </div>
        <a class="btn btn--ghost btn--sm" style="margin-top:8px;" href="/formation/theorie/<%= c.id %>"><%- icon('book', 14) %> Fiche de théorie</a>
      </div>
    <% }) %>
  </div>

  <!-- Niveaux -->
  <h2 class="section-title">Les 3 niveaux de concours</h2>
  <div class="fniv-grid">
    <% niveaux.forEach(function(n){ %>
      <div class="panel fniv-card">
        <h3><%= n.label %></h3>
        <span class="badge badge--soft"><%= n.sousTitre %></span>
        <p class="muted"><%= n.desc %></p>
      </div>
    <% }) %>
  </div>

  <% if (dernieres.length) { %>
    <h2 class="section-title">Mes derniers tests</h2>
    <div class="panel" style="overflow-x:auto;">
      <table class="table">
        <thead><tr><th>Date</th><th>Catégorie</th><th>Niveau</th><th>Mode</th><th>Score</th><th></th></tr></thead>
        <tbody>
          <% dernieres.forEach(function(a){ var c = meta.categorie(a.categorie); var n = meta.niveau(a.niveau); var pct = Math.round((a.score / a.nbQuestions) * 100); %>
            <tr>
              <td><%= new Date(a.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' }) %></td>
              <td><%= c ? c.label : a.categorie %></td>
              <td><%= n ? n.label : a.niveau %></td>
              <td><%= a.mode === 'examen' ? '⏱️ Concours' : '🎯 Entraînement' %></td>
              <td><span class="badge <%= pct >= 60 ? 'badge--ok' : 'badge--no' %>"><%= a.score %>/<%= a.nbQuestions %></span></td>
              <td><a class="btn btn--ghost btn--sm" href="/formation/tests/<%= a.id %>/resultat">Voir</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<script src="/js/formation-tts.js?v=<%= v('js/formation-tts.js') %>" defer></script>
