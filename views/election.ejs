<%# Espace de vote : élection du Président de l'AIDUS (routes/elections.js).
    Locals : s (scrutin), ph (test | attente | ouvert | clos), candidats, part (participation),
    resultats (ou null), superAdmin, etape (identification | bulletin | code | fait), st (session),
    attente (vote en attente), bureau (terminal du bureau de vote), pieceJointe (pièce déjà envoyée ; aperçu
    servi à l'électeur par /elections/aidus/piece), brouillon
    (choix et e-mail gardés après une erreur), proposerNul (aucune case cochée : confirmation du bulletin nul),
    candidatChoisi, formatGmt, formatPiece, plageGmt, minutesCode %>
<% var ouvert = ph === 'test' || ph === 'ouvert'; %>
<section class="container space election">
  <div class="space__head">
    <div>
      <span class="badge badge--soft">🗳️ Élection en ligne</span>
      <h1 class="space__title" style="margin-top:6px;"><%= s.titre %></h1>
      <p class="space__sub">Vote <strong><%= plageGmt(s) %></strong>.
        <% if (s.sousTitre) { %><br><%= s.sousTitre %><% } %></p>
    </div>
    <% if (superAdmin) { %><a href="/admin/elections" class="btn btn--ghost btn--sm">⚙️ Administration du scrutin</a><% } %>
  </div>

  <%# Phase du scrutin %>
  <% if (ph === 'test') { %>
    <div class="election-phase election-phase--test" role="status">🧪 <strong>Période de test.</strong> Les votes enregistrés maintenant servent aux essais :
      ils seront tous effacés au plus tard le <strong><%= formatGmt(s.reinitialiserA && s.reinitialiserA < s.debut ? s.reinitialiserA : s.debut) %></strong>
      (réinitialisation de l’espace de vote). Le vrai vote se déroulera le <%= formatGmt(s.debut) %>.</div>
  <% } else if (ph === 'attente') { %>
    <div class="election-phase" role="status">⏳ Le vote ouvrira le <strong><%= formatGmt(s.debut) %></strong> et fermera à <strong><%= formatGmt(s.fin).replace(/^.* à /, '') %></strong>.</div>
  <% } else if (ph === 'ouvert') { %>
    <div class="election-phase election-phase--ouvert" role="status">✅ <strong>Le vote est ouvert</strong> jusqu’à <%= formatGmt(s.fin).replace(/^.* à /, '') %>.</div>
  <% } else { %>
    <div class="election-phase election-phase--clos" role="status">🔒 <strong>Le vote est clos.</strong>
      <%= s.resultatsPublies ? 'Les résultats officiels sont affichés ci-dessous.' : 'Les résultats seront publiés par le comité électoral.' %></div>
  <% } %>

  <div class="election-participation" role="group" aria-label="Participation">
    <div><strong><%= part.votants %></strong><span>votant<%= part.votants > 1 ? 's' : '' %></span></div>
    <div><strong><%= part.electeurs %></strong><span>électeurs inscrits</span></div>
    <div><strong><%= String(part.taux).replace('.', ',') %> %</strong><span>de participation</span></div>
  </div>

  <%# Résultats (publiés après la clôture ; super admin : aussi pendant les tests) %>
  <% if (resultats) { %>
    <div class="panel election-resultats" id="resultats">
      <h2 class="election-h2">📊 Résultats<% if (!(s.resultatsPublies && ph === 'clos')) { %> <span class="badge badge--soft">visibles par le super admin seulement<%= ph === 'test' ? ' (votes de test)' : '' %></span><% } %></h2>
      <p class="muted" style="margin-top:0;"><%= resultats.total %> bulletin<%= resultats.total > 1 ? 's' : '' %> dans l’urne :
        <strong><%= resultats.exprimes %></strong> exprimé<%= resultats.exprimes > 1 ? 's' : '' %>,
        <strong><%= resultats.nuls %></strong> nul<%= resultats.nuls > 1 ? 's' : '' %><%= resultats.total ? ' (' + String(resultats.pourcentageNuls).replace('.', ',') + ' % des bulletins)' : '' %>.
        Pourcentages des candidats calculés sur les suffrages exprimés.</p>
      <% resultats.lignes.forEach(function (l, i) { %>
        <div class="election-barre">
          <div class="election-barre__tete"><span><%= l.voix > 0 && l.voix === resultats.lignes[0].voix ? '🏆 ' : '' %><strong><%= l.nom %></strong></span><span><%= l.voix %> voix · <%= String(l.pourcentage).replace('.', ',') %> %</span></div>
          <div class="election-barre__fond"><div class="election-barre__plein" style="width: <%= l.pourcentage %>%;"></div></div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <%# Candidats : l'affiche officielle (sur le bulletin, elle devient interactive) %>
  <% if (!(ouvert && etape === 'bulletin')) { %>
    <h2 class="election-h2">Les candidats</h2>
    <%- include('partials/election-affiche', { candidats: candidats, interactif: false }) %>
    <% var presentations = candidats.filter(function (c) { return c.presentation; }); %>
    <% if (presentations.length) { %>
      <div class="election-presentations">
        <% presentations.forEach(function (c) { %><p><strong><%= c.nom %></strong> — <%= c.presentation %></p><% }) %>
      </div>
    <% } %>
  <% } %>

  <%# Le vote %>
  <div class="panel election-vote" id="vote">
    <h2 class="election-h2">🗳️ Voter<% if (bureau) { %> <span class="badge badge--soft" <%= ['identification', 'bulletin', 'code'].includes(etape) ? 'data-terminal-bureau' : '' %>>Terminal du bureau de vote (présentiel)</span><% } %></h2>
    <% if (!ouvert && etape !== 'fait') { %>
      <p style="margin:0;"><%= ph === 'clos' ? 'Le vote est clos.' : 'Le vote n’est pas encore ouvert : revenez le ' + formatGmt(s.debut) + '.' %></p>
    <% } else if (etape === 'fait') { %>
      <div class="election-fait" role="status">
        <p class="election-fait__titre">✅ A voté !</p>
        <p style="margin:0;">Votre vote a été enregistré le <strong><%= formatGmt(st.fait.le) %></strong><%= st.fait.mode === 'presentiel' ? ' (au bureau de vote)' : '' %>.
          Il est secret : l’émargement indique que vous avez voté, jamais pour qui. Merci pour votre participation.</p>
      </div>
      <form method="POST" action="/elections/aidus/annuler" class="election-annuler" id="formSuivant">
        <button type="submit" class="btn <%= bureau ? 'btn--primary' : 'btn--ghost btn--sm' %>"><%= bureau ? 'Électeur suivant →' : '↺ Nouveau vote sur cet appareil' %></button>
        <% if (bureau) { %><span class="muted election-aide" id="suivantCompte" data-secondes="15"> (automatique dans 15 s)</span><% } %>
      </form>
    <% } else { %>
      <ol class="election-etapes" aria-label="Étapes du vote">
        <li class="<%= etape === 'identification' ? 'is-actif' : 'is-fait' %>">1. Identification</li>
        <li class="<%= etape === 'bulletin' ? 'is-actif' : etape === 'code' ? 'is-fait' : '' %>">2. Choix du candidat</li>
        <li class="<%= etape === 'code' ? 'is-actif' : '' %>">3. Confirmation</li>
      </ol>

      <% if (etape === 'identification') { const sa = st.saisie || {}; const passeport = sa.typePiece === 'passeport'; %>
        <form method="POST" action="/elections/aidus/identifier" class="election-form" autocomplete="off">
          <p class="muted" style="margin-top:0;">Vos informations sont comparées à la <strong>liste électorale</strong>. Elles doivent correspondre exactement.</p>
          <div class="election-grille">
            <label>Nom de famille *<input type="text" name="nom" required maxlength="80" autocapitalize="characters" value="<%= sa.nom || '' %>"></label>
            <label>Prénom(s) *<input type="text" name="prenom" required maxlength="120" value="<%= sa.prenom || '' %>"></label>
            <label>Année d’entrée à l’Université Senghor *<input type="number" name="anneeEntree" required min="1980" max="2030" inputmode="numeric" placeholder="ex. 2015" value="<%= sa.anneeEntree || '' %>"></label>
            <label>Année d’obtention du diplôme *<input type="number" name="anneeDiplome" required min="1980" max="2030" inputmode="numeric" placeholder="ex. 2017" value="<%= sa.anneeDiplome || '' %>"></label>
          </div>
          <fieldset class="election-piece">
            <legend>Pièce d’identité *</legend>
            <label class="check-pill"><input type="radio" name="typePiece" value="cni" required data-piece <%= passeport ? '' : 'checked' %>><span>CNI</span></label>
            <label class="check-pill"><input type="radio" name="typePiece" value="passeport" data-piece <%= passeport ? 'checked' : '' %>><span>Passeport</span></label>
            <label class="election-piece__numero">Numéro de la pièce *
              <input type="text" name="numeroPiece" id="numeroPiece" required maxlength="20" autocapitalize="characters" placeholder="<%= passeport ? '20AB12345' : 'CI123456789 ou C 1234 5678 90' %>">
            </label>
            <p class="muted election-aide" id="aidePiece"><% if (passeport) { %>Passeport ivoirien : <strong>2 chiffres, 2 lettres puis 5 chiffres</strong> (ex. 20AB12345).<% } else { %>CNI : <strong>CI</strong> suivi de 9 chiffres (nouvelle CNI, ex. CI123456789) ou <strong>C</strong> suivi de 10 chiffres (ancienne CNI de 2010, ex. C 1234 5678 90).<% } %></p>
          </fieldset>
          <button type="submit" class="btn btn--primary">Continuer →</button>
        </form>
      <% } else if (etape === 'bulletin') { %>
        <form method="POST" action="/elections/aidus/voter" class="election-form" enctype="multipart/form-data" id="formBulletin">
          <p style="margin-top:0;">Bonjour <strong><%= st.nomAffiche %></strong>. Cochez la <strong>case blanche</strong> sous la photo de votre candidat.
            Si vous ne cochez aucune case, votre bulletin sera <strong>nul</strong> (touchez de nouveau une case cochée pour la décocher).</p>
          <%- include('partials/election-affiche', { candidats: candidats, interactif: true, choisi: brouillon.candidat }) %>
          <p class="election-choix-lu" id="choixLu" aria-live="polite" hidden></p>
          <div class="election-alerte" role="note">⚠️ <strong>Attention :</strong> vérifiez bien le <strong>nom</strong> et la <strong>photo</strong> de votre candidat avant de valider.</div>
          <label class="election-nul" id="confirmNul" <%= proposerNul ? '' : 'hidden' %>>
            <input type="checkbox" name="nul" value="1" id="champNul">
            <span>Je n’ai coché aucune case : je confirme mon <strong>bulletin nul</strong> (aucun candidat).</span>
          </label>
          <label class="election-email"><%= bureau ? 'Adresse e-mail (facultative au bureau de vote)' : 'Adresse e-mail *' %>
            <input type="email" name="email" maxlength="120" autocomplete="email" <%= bureau ? '' : 'required' %> placeholder="vous@exemple.com" value="<%= brouillon.email || '' %>">
          </label>
          <% if (st.aEmailListe) { %>
            <p class="muted election-aide">Utilisez l’adresse inscrite pour vous sur la liste électorale : <strong><%= st.emailsMasques.join(' ou ') %></strong>.</p>
          <% } else if (!bureau) { %>
            <p class="muted election-aide">Vous y recevrez un <strong>code de confirmation</strong>, à saisir sur cet appareil. Une adresse e-mail ne peut confirmer qu’un seul vote.</p>
          <% } %>
          <% if (!bureau) { var estPasseport = /^PASSEPORT/.test(st.cni || ''); var nomPiece = estPasseport ? 'la page d’identité de votre passeport' : 'le recto de votre CNI'; %>
            <%# Pièce d'identité : photo prise directement (appareil photo dans la page, ou appareil photo
                du téléphone), puis rognage (public/js/election-piece.js) ; pas de choix de fichier %>
            <div class="election-piecejointe" id="zonePiece" data-type="<%= estPasseport ? 'passeport' : 'cni' %>" data-jointe="<%= pieceJointe ? '1' : '0' %>" data-cle="<%= st.cni %>">
              <p class="election-piecejointe__titre">Photo de votre pièce d’identité<%= pieceJointe ? '' : ' *' %> <span class="muted">(<%= formatPiece(st.cni) %>)</span></p>
              <% if (pieceJointe) { %><p class="election-piece-ok">✓ Votre pièce d’identité est déjà jointe. Vous pouvez la reprendre si besoin.</p><% } %>
              <div class="election-piecejointe__actions" data-avec-js hidden>
                <button type="button" class="btn btn--primary" id="btnCamera">📷 <%= pieceJointe ? 'Reprendre la photo' : 'Photographier ma pièce' %></button>
              </div>
              <label class="election-piecejointe__fichier" data-sans-js>Photo de votre pièce d’identité
                <input type="file" name="piece" id="champPiece" accept="image/*" capture="environment" <%= pieceJointe ? '' : 'required' %>>
              </label>
              <input type="hidden" name="prisLe" id="prisLePiece" value="">
              <input type="hidden" name="sourcePhoto" id="sourcePiece" value="">
              <input type="hidden" name="envoyeLe" id="envoyeLePiece" value="">
              <p class="muted election-aide">Photographiez <%= nomPiece %> : votre photo, votre nom et le numéro saisi doivent être lisibles.
                Posez la pièce à plat, en bonne lumière, sans reflet ; vous pourrez ensuite rogner l’image autour de la pièce. Elle est réduite automatiquement (légère et lisible), <strong>horodatée par le site</strong> à sa réception
                et n’est vue que par le Comité électoral, pour vérifier que vous êtes bien la personne inscrite sur la liste électorale.</p>
              <div class="election-apercu" id="apercuPiece" <%= pieceJointe ? '' : 'hidden' %>>
                <img alt="Aperçu de votre pièce d’identité" <% if (pieceJointe && typeof pieceApercu !== 'undefined' && pieceApercu) { %>src="/elections/aidus/piece?v=<%= String(st.pieceId).slice(0, 8) %>"<% } else { %>hidden<% } %>>
                <span data-info><%= pieceJointe ? 'Pièce déjà jointe.' : '' %></span>
                <button type="button" class="btn btn--ghost btn--sm" id="btnRecadrer" hidden>✎ Recadrer</button>
              </div>
              <p class="election-alerte" id="erreurPiece" role="alert" hidden></p>

              <dialog class="piece-dlg" id="dlgPiece" aria-labelledby="dlgPieceTitre">
                <div class="piece-dlg__ecran" data-ecran="camera">
                  <p class="piece-dlg__titre" id="dlgPieceTitre">📷 Photographiez <%= nomPiece %></p>
                  <div class="piece-camera">
                    <video id="videoPiece" playsinline muted autoplay></video>
                    <div class="piece-camera__guide" aria-hidden="true"></div>
                  </div>
                  <p class="piece-dlg__aide">Placez la pièce dans le cadre, à plat, bien éclairée, sans reflet.</p>
                  <p class="election-alerte" id="erreurCamera" role="alert" hidden></p>
                  <div class="piece-dlg__boutons piece-dlg__boutons--camera">
                    <button type="button" class="btn btn--ghost btn--sm" data-action="fermer">Annuler</button>
                    <button type="button" class="piece-declencheur" data-action="declencher" aria-label="Prendre la photo"></button>
                  </div>
                  <div class="piece-dlg__secours" data-secours>
                    <button type="button" class="btn btn--primary" data-action="telephone" data-telephone>📷 Ouvrir l’appareil photo du téléphone</button>
                  </div>
                </div>
                <div class="piece-dlg__ecran" data-ecran="rognage" hidden>
                  <p class="piece-dlg__titre">✂️ Ajustez le cadre autour de la pièce</p>
                  <div class="piece-rognage">
                    <canvas id="toileRognage"></canvas>
                    <div class="piece-rognage__cadre" id="cadreRognage" tabindex="0" role="application" aria-label="Cadre de rognage : faites-le glisser ou tirez ses coins ; au clavier, flèches pour déplacer, Maj et flèches pour agrandir ou réduire">
                      <span data-coin="nw"></span><span data-coin="ne"></span><span data-coin="sw"></span><span data-coin="se"></span>
                    </div>
                  </div>
                  <p class="election-alerte" id="erreurRognage" role="alert" hidden></p>
                  <div class="piece-dlg__boutons">
                    <button type="button" class="btn btn--ghost btn--sm" data-action="reprendre">↺ Reprendre</button>
                    <button type="button" class="btn btn--ghost btn--sm" data-action="pivoter">⟳ Pivoter</button>
                    <button type="button" class="btn btn--ghost btn--sm" data-action="entiere">⤢ Image entière</button>
                    <button type="button" class="btn btn--primary" data-action="valider">✓ Valider</button>
                  </div>
                </div>
              </dialog>
            </div>
          <% } %>
          <div class="election-actions">
            <button type="submit" class="btn btn--primary"><%= bureau ? 'Valider mon choix →' : 'Recevoir mon code de confirmation →' %></button>
          </div>
        </form>
        <form method="POST" action="/elections/aidus/annuler" class="election-annuler"><button type="submit" class="btn btn--ghost btn--sm">↺ Recommencer</button></form>
      <% } else if (etape === 'code') { %>
        <p style="margin-top:0;">Votre choix : <strong class="election-choix-confirme<%= candidatChoisi && candidatChoisi.nul ? ' election-choix-confirme--nul' : '' %>"><%= candidatChoisi ? candidatChoisi.nom : '' %></strong>. Vérifiez-le : ce n’est pas ce que vous voulez ? Touchez « Changer de choix ».</p>
        <% if (attente.mode === 'presentiel') { %>
          <form method="POST" action="/elections/aidus/confirmer" class="election-form" data-un-envoi>
            <p class="muted">Au bureau de vote, l’identité est contrôlée par les membres du bureau. Confirmez pour enregistrer le vote.</p>
            <button type="submit" class="btn btn--primary">✅ Confirmer mon vote</button>
          </form>
        <% } else { %>
          <form method="POST" action="/elections/aidus/confirmer" class="election-form" autocomplete="off" data-un-envoi>
            <p>Un code à 6 chiffres vient d’être envoyé à <strong><%= attente.email %></strong>. Saisissez-le <strong>sur cet appareil</strong>
              (valable <%= minutesCode %> minutes ; pensez à regarder vos courriers indésirables).</p>
            <label class="election-code">Code de confirmation
              <input type="text" name="code" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="••••••">
            </label>
            <button type="submit" class="btn btn--primary">✅ Confirmer mon vote</button>
          </form>
          <form method="POST" action="/elections/aidus/renvoyer" class="election-annuler"><button type="submit" class="btn btn--ghost btn--sm">✉️ Renvoyer le code</button></form>
        <% } %>
        <form method="POST" action="/elections/aidus/changer" class="election-annuler"><button type="submit" class="btn btn--ghost btn--sm">✎ Changer de choix</button></form>
        <form method="POST" action="/elections/aidus/annuler" class="election-annuler"><button type="submit" class="btn btn--ghost btn--sm">↺ Recommencer</button></form>
      <% } %>
    <% } %>
  </div>

  <%# Le processus du vote, expliqué %>
  <div class="panel election-processus" id="processus">
    <h2 class="election-h2">Comment se déroule le vote ?</h2>
    <ol class="election-liste">
      <li><strong>Identification.</strong> Vous saisissez votre nom, vos prénoms, votre année d’entrée à l’Université Senghor et votre année d’obtention du diplôme :
        ces informations sont comparées à la <strong>liste électorale</strong>, qui fait foi. Si une information est fausse, le vote est refusé.
        Vous indiquez aussi votre pièce d’identité : <strong>CNI</strong> (nouvelle : CI + 9 chiffres ; ancienne de 2010 : C + 10 chiffres) ou <strong>passeport</strong> ivoirien.</li>
      <li><strong>Choix du candidat.</strong> Vous cochez la case de votre candidat parmi les <%= candidats.length %>, présentés comme sur l’affiche officielle.
        Si vous ne cochez aucune case (et le confirmez), votre bulletin est <strong>nul</strong> : il compte dans la participation, pour aucun candidat.
        En ligne, vous <strong>photographiez votre pièce d’identité</strong> avec l’appareil photo (téléphone ou ordinateur), puis vous la cadrez : le Comité électoral vérifie que vous êtes bien la personne inscrite.</li>
      <li><strong>Confirmation par e-mail.</strong> Un code à 6 chiffres est envoyé à votre adresse e-mail (celle de la liste électorale si elle y figure).
        Il se saisit <strong>sur l’appareil où le vote a commencé</strong> : personne ne peut commencer un vote à votre place et le terminer ailleurs.</li>
      <li><strong>Vote enregistré.</strong> Votre nom est inscrit sur la liste d’émargement (qui a voté, quand, depuis quel appareil et quelle adresse IP).
        Votre bulletin est rangé à part, <strong>sans votre nom ni l’heure</strong> : le vote reste secret.</li>
    </ol>
    <h3 class="election-h3">Les contrôles</h3>
    <ul class="election-liste">
      <li><strong>Un électeur = un vote</strong> ; <strong>une pièce d’identité = un vote</strong> ; <strong>une adresse e-mail = un vote</strong>.</li>
      <li><strong>En ligne et en présentiel, une seule liste d’émargement</strong> : celui qui a voté en ligne ne peut plus voter au bureau de vote, et inversement.
        Au bureau, on vote sur un terminal dédié (téléphone ou ordinateur), sur ce même site ; l’identité y est contrôlée par les membres du bureau.</li>
      <li>Chaque vote est horodaté avec l’adresse IP et l’appareil utilisés, pour permettre au comité électoral les croisements nécessaires.</li>
      <li>La <strong>liste d’émargement</strong> est consultable à tout instant par le super administrateur et les membres du bureau de vote, avec les pièces d’identité jointes.
        Ces pièces ne sont jamais publiques et sont supprimées une fois les vérifications terminées.</li>
      <li>Une fois le vote ouvert, <strong>aucun vote émis ne peut être modifié ni supprimé, pas même par le super administrateur</strong> :
        la base de données le refuse. Chaque action du super administrateur est inscrite dans un <strong>journal des opérations</strong>
        non modifiable, consultable par le bureau de vote et par les candidats ou leurs représentants.</li>
      <li>Les résultats par candidat restent cachés jusqu’à la clôture (<%= formatGmt(s.fin).replace(/^.* à /, '') %>), puis sont publiés par le comité.</li>
    </ul>
    <h3 class="election-h3">Calendrier</h3>
    <ul class="election-liste">
      <li><strong>Période de test</strong> : jusqu’au <%= formatGmt(s.reinitialiserA && s.reinitialiserA < s.debut ? s.reinitialiserA : s.debut) %>. Les votes de test sont alors tous effacés (réinitialisation), pour un vote transparent.</li>
      <li><strong>Vote</strong> : <%= plageGmt(s) %>.</li>
      <li><strong>Résultats</strong> : publiés après la clôture.</li>
    </ul>
    <p class="election-bureau-lien"><a href="/elections/aidus/emargement">🔐 Bureau de vote : liste d’émargement</a> · <a href="/elections/aidus/journal">📜 Journal des opérations (bureau de vote, candidats et représentants)</a></p>
  </div>
</section>
<script>
  // Pièce d'identité : aide et exemple selon le type choisi
  (function () {
    var champ = document.getElementById('numeroPiece');
    var aide = document.getElementById('aidePiece');
    if (!champ || !aide) return;
    var textes = {
      cni: ['CI123456789 ou C 1234 5678 90', 'CNI : <strong>CI</strong> suivi de 9 chiffres (nouvelle CNI, ex. CI123456789) ou <strong>C</strong> suivi de 10 chiffres (ancienne CNI de 2010, ex. C 1234 5678 90).'],
      passeport: ['20AB12345', 'Passeport ivoirien : <strong>2 chiffres, 2 lettres puis 5 chiffres</strong> (ex. 20AB12345).'],
    };
    document.querySelectorAll('[data-piece]').forEach(function (r) {
      r.addEventListener('change', function () { var t = textes[r.value]; champ.placeholder = t[0]; aide.innerHTML = t[1]; champ.focus(); });
    });
  })();

  // Bulletin : rappel du choix coché ; pas de double envoi
  (function () {
    var form = document.getElementById('formBulletin');
    if (!form) return;
    var lu = document.getElementById('choixLu');
    var confirmNul = document.getElementById('confirmNul'), champNul = document.getElementById('champNul');
    function lire(r) {
      lu.hidden = false;
      lu.textContent = 'Votre choix : ' + r.getAttribute('aria-label').replace(/^Voter pour /, '') + '.';
      champNul.checked = false;
      confirmNul.hidden = true;
    }
    form.querySelectorAll('input[name="candidat"]').forEach(function (r) {
      r.addEventListener('change', function () { lire(r); });
      if (r.checked) lire(r);
    });
    // Toucher de nouveau une case cochée la décoche (pour revenir à « aucun choix » : bulletin nul)
    form.querySelectorAll('.affiche__carte').forEach(function (carte) {
      var r = carte.querySelector('input[name="candidat"]');
      var etaitCochee = false;
      carte.addEventListener('pointerdown', function () { etaitCochee = r.checked; });
      carte.addEventListener('click', function (ev) {
        if (!etaitCochee || !r.checked || ev.target === r) return;
        ev.preventDefault();
        r.checked = false;
        etaitCochee = false;
        lu.hidden = true;
        lu.textContent = '';
      });
    });
    champNul.addEventListener('change', function () {
      lu.hidden = !champNul.checked;
      lu.textContent = champNul.checked ? 'Votre choix : bulletin nul (aucun candidat).' : '';
    });
    // Aucune case cochée : le bulletin nul doit être confirmé (pas de nul par simple oubli)
    form.addEventListener('submit', function (ev) {
      if (form.querySelector('input[name="candidat"]:checked') || champNul.checked) return;
      ev.preventDefault();
      confirmNul.hidden = false;
      confirmNul.classList.add('is-attention');
      confirmNul.scrollIntoView({ behavior: 'smooth', block: 'center' });
      champNul.focus();
    });
    form.addEventListener('submit', function (ev) { var b = form.querySelector('[type="submit"]'); setTimeout(function () { if (ev.defaultPrevented) return; b.disabled = true; b.textContent = 'Envoi en cours…'; }, 0); });
  })();
  document.querySelectorAll('form[data-un-envoi]').forEach(function (f) {
    f.addEventListener('submit', function () { var b = f.querySelector('[type="submit"]'); setTimeout(function () { b.disabled = true; b.textContent = 'Enregistrement…'; }, 0); });
  });

  // Terminal du bureau de vote : électeur suivant automatiquement après « A voté ! »,
  // et parcours effacé après 3 minutes sans activité (l'électeur suivant ne voit rien du précédent)
  (function () {
    var compte = document.getElementById('suivantCompte');
    if (compte) {
      var n = Number(compte.dataset.secondes) || 15;
      var minuterie = setInterval(function () {
        n -= 1; compte.textContent = ' (automatique dans ' + n + ' s)';
        if (n <= 0) { clearInterval(minuterie); document.getElementById('formSuivant').submit(); }
      }, 1000);
      return;
    }
    if (!document.querySelector('[data-terminal-bureau]')) return;
    var delai = 3 * 60 * 1000, dernier = Date.now();
    ['input', 'click', 'keydown', 'touchstart', 'scroll'].forEach(function (ev) { document.addEventListener(ev, function () { dernier = Date.now(); }, { passive: true }); });
    setInterval(function () {
      if (Date.now() - dernier < delai) return;
      var f = document.createElement('form'); f.method = 'POST'; f.action = '/elections/aidus/annuler'; document.body.appendChild(f); f.submit();
    }, 15000);
  })();
</script>
<% if (ouvert && etape === 'bulletin' && !bureau) { %><script src="/js/election-piece.js?v=<%= v('js/election-piece.js') %>" defer></script><% } %>
