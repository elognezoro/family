<section class="container space">
  <div class="space__head">
    <div>
      <h1 class="space__title"><%- icon('award', 26) %> Mon espace Candidat</h1>
      <p class="space__sub">Votre préparation aux tests psychotechniques, en un coup d'œil.</p>
    </div>
  </div>

  <!-- Statut d'accès -->
  <% if (approuve) { %>
    <div class="info-banner"><%- icon('check', 16) %> Votre accès à la Formation est <strong>actif</strong><%= enrollment.expiresAt ? ' jusqu’au ' + new Date(enrollment.expiresAt).toLocaleDateString('fr-FR') : '' %>. Bonne préparation !</div>
  <% } else if (enrollment && enrollment.statut === 'pending') { %>
    <div class="info-banner"><%- icon('clock', 16) %> Votre demande d’accès est <strong>en attente de validation</strong> par un administrateur — vous serez prévenu par e-mail.</div>
  <% } else { %>
    <div class="info-banner info-banner--warn"><%- icon('edit', 16) %> Vous n’avez pas encore d’accès aux tests : rendez-vous sur la page <a href="/formation">Formation</a> pour payer une formule ou demander une autorisation.</div>
  <% } %>

  <!-- ═══ MES DEUX ÉPREUVES ═══ -->
  <h2 class="section-title">Mes deux épreuves</h2>
  <div class="fdomaines">
    <div class="panel fdomaine" style="--cat: #1E9E57">
      <div class="fdomaine__tete"><span class="fdomaine__emoji">🧠</span>
        <div><h3>Tests psychotechniques</h3>
        <p class="muted">Les épreuves d'aptitude : logique, calcul, vocabulaire, attention, organisation, mémoire — <%= totalQuestions %> questions, 3 niveaux.</p></div>
      </div>
      <div class="fcat-card__meta">
        <span class="badge badge--soft"><%= progression.reduce(function(s, p){ return s + p.tentatives; }, 0) %> test<%= progression.reduce(function(s, p){ return s + p.tentatives; }, 0) > 1 ? 's' : '' %> terminé<%= progression.reduce(function(s, p){ return s + p.tentatives; }, 0) > 1 ? 's' : '' %></span>
      </div>
      <div class="fdomaine__actions">
        <a class="btn btn--primary btn--sm" href="/formation/psychotechniques"><%- icon('award', 15) %> Ouvrir le module</a>
        <a class="btn btn--ghost btn--sm" href="/formation/tests"><%- icon('edit', 15) %> Passer un test</a>
      </div>
    </div>
    <div class="panel fdomaine" style="--cat: #B45309">
      <div class="fdomaine__tete"><span class="fdomaine__emoji">⚖️</span>
        <div><h3>Statut général de la Fonction Publique</h3>
        <p class="muted">L'épreuve de connaissances : la loi n° 2023-892 en 15 séquences de cours, <%= totalFp %> exercices, jeux, révision espacée et Simulation Concours.</p></div>
      </div>
      <div class="fcat-card__meta">
        <span class="badge badge--soft"><%= fp.tests %> test<%= fp.tests > 1 ? 's' : '' %></span>
        <span class="badge <%= fp.maitrisePct >= 70 ? 'badge--ok' : 'badge--soft' %>">🗺️ maîtrise <%= fp.maitrisePct %> % (<%= fp.articlesVus %>/116 art.)</span>
        <% if (fp.xp > 0) { %><span class="badge badge--soft">⭐ <%= fp.xp %> XP · <%= fp.niveau.label %></span><% } %>
        <% if (fp.serie > 1) { %><span class="badge badge--ok">🔥 <%= fp.serie %> j</span><% } %>
        <% if (fp.meilleureSimulation !== null) { %><span class="badge <%= fp.meilleureSimulation >= 90 ? 'badge--ok' : 'badge--no' %>">⏱️ simulation <%= fp.meilleureSimulation %> %</span><% } %>
        <% if (fp.aRevoir > 0) { %><span class="badge badge--no">📆 <%= fp.aRevoir %> article<%= fp.aRevoir > 1 ? 's' : '' %> à réviser</span><% } %>
      </div>
      <div class="fdomaine__actions">
        <a class="btn btn--primary btn--sm" href="/formation/fonction-publique"><%- icon('shield', 15) %> Ouvrir le module</a>
        <a class="btn btn--ghost btn--sm" href="/formation/fonction-publique/jeux">🎮 Jeux</a>
        <a class="btn btn--ghost btn--sm" href="/formation/fonction-publique/progression">🗺️ Ma carte</a>
      </div>
    </div>
  </div>

  <!-- Actions générales -->
  <div class="formation-actions panel">
    <a class="btn btn--ghost" href="/formation/historique"><%- icon('doc', 18) %> Mes résultats (toutes épreuves)</a>
    <a class="btn btn--ghost" href="/parrainage"><%- icon('cash', 18) %> Parrainage &amp; gains</a>
    <a class="btn btn--ghost" href="/guides"><%- icon('book', 18) %> Mon guide</a>
  </div>

  <h2 class="section-title">Ma progression — Tests psychotechniques</h2>
  <div class="fcat-grid">
    <% progression.forEach(function(p){ %>
      <div class="panel fcat-card" style="--cat: <%= p.cat.couleur %>">
        <div class="fcat-card__icon"><%- icon(p.cat.icon, 24) %></div>
        <h3><%= p.cat.label %></h3>
        <div class="fcat-card__meta">
          <span class="badge badge--soft"><%= p.tentatives %> test<%= p.tentatives > 1 ? 's' : '' %></span>
          <% if (p.meilleurExamen !== null) { %><span class="badge <%= p.meilleurExamen >= 60 ? 'badge--ok' : 'badge--no' %>">⏱️ <%= p.meilleurExamen %> %</span><% } %>
          <% if (p.meilleurEntrainement !== null) { %><span class="badge badge--soft">🎯 <%= p.meilleurEntrainement %> %</span><% } %>
        </div>
        <a class="btn btn--ghost btn--sm" style="margin-top:8px;" href="/formation/theorie/<%= p.cat.id %>">Revoir la théorie</a>
      </div>
    <% }) %>
  </div>

  <% if (attempts.length) { %>
    <h2 class="section-title">Mes derniers tests</h2>
    <div class="panel" style="overflow-x:auto;">
      <table class="table">
        <thead><tr><th>Date</th><th>Catégorie</th><th>Mode</th><th>Score</th><th></th></tr></thead>
        <tbody>
          <% attempts.forEach(function(a){ var c = meta.categorie(a.categorie); var pct = Math.round((a.score / a.nbQuestions) * 100); %>
            <tr>
              <td><%= new Date(a.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' }) %></td>
              <td><%= c ? c.label : a.categorie %></td>
              <td><%= a.mode === 'examen' ? '⏱️ Concours' : '🎯 Entraînement' %></td>
              <td><span class="badge <%= pct >= 60 ? 'badge--ok' : 'badge--no' %>"><%= a.score %>/<%= a.nbQuestions %></span></td>
              <td><a class="btn btn--ghost btn--sm" href="/formation/tests/<%= a.id %>/resultat">Voir</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
