<%# Banque de ressources didactiques — accordéons par niveau (6e → Tle),
    tuiles par discipline, clips dans chaque tuile.
    Locals : niveaux, stats {consultations, vues, telechargements}, nombreFr, chantDe %>
<section class="container space">
  <div class="space__head">
    <div>
      <h1 class="space__title">📚 Banque de ressources didactiques</h1>
      <p class="space__sub">Des ressources gratuites pour apprendre et réviser, classées par niveau — sélectionnées par l'équipe EduWeb.</p>
    </div>
    <a href="/dons" class="btn btn--primary btn--sm">💛 Soutenir la banque</a>
  </div>

  <%# Fréquentation de la banque : visites de la page, consultations et téléchargements cumulés %>
  <div class="banque-stats" role="group" aria-label="Fréquentation de la banque de ressources">
    <div class="banque-stats__item">
      <span class="banque-stats__val">👁️ <%= nombreFr(stats.consultations) %></span>
      <span class="banque-stats__lib">visite<%= stats.consultations > 1 ? 's' : '' %> de la banque</span>
    </div>
    <div class="banque-stats__item">
      <span class="banque-stats__val">▶️ <%= nombreFr(stats.vues) %></span>
      <span class="banque-stats__lib">consultation<%= stats.vues > 1 ? 's' : '' %> de ressources</span>
    </div>
    <div class="banque-stats__item">
      <span class="banque-stats__val">⬇️ <%= nombreFr(stats.telechargements) %></span>
      <span class="banque-stats__lib">téléchargement<%= stats.telechargements > 1 ? 's' : '' %></span>
    </div>
  </div>

  <div class="info-banner info-banner--warn">
    <span>⚠️</span>
    <p style="margin:0;"><strong>Attention :</strong> l'ordre des leçons pourrait ne pas être le même que celui du livre
    ou de la progression affichée dans votre cahier de texte. Fiez-vous plutôt aux <strong>titres</strong> pour évoluer
    dans votre apprentissage, selon l'ordre officiel de progression en vigueur dans votre établissement.</p>
  </div>

  <div class="editions__loterie" style="background: var(--panel-bg, #fff); color: inherit; border-color: rgba(14,107,58,.25);">
    <div class="editions__loterie-txt">
      <strong>🎵 Les chansons des annales</strong> — apprenez en chantant : chaque annale EduWeb Éditions
      offre ses chansons mnémotechniques, débloquées par le code unique du livre.
    </div>
    <a class="btn btn--ghost" href="/chansons">🎵 Ouvrir les chansons</a>
  </div>

  <% if (!niveaux.length) { %>
    <div class="panel"><div class="empty">📚<p>La banque se remplit bientôt — repassez très vite !</p></div></div>
  <% } %>

  <%# Accordéons par niveau (classés de la 6e à la Terminale), tuiles par discipline %>
  <%# Tous les accordéons sont repliés par défaut : l'utilisateur ouvre son niveau %>
  <% niveaux.forEach(function(n){ %>
    <details class="niv-acc">
      <summary class="niv-acc__resume">
        <span class="niv-acc__nom">🎓 <%= n.niveau %></span>
        <span class="niv-acc__compte"><%= n.total %> ressource<%= n.total > 1 ? 's' : '' %> · <%= n.disciplines.length %> discipline<%= n.disciplines.length > 1 ? 's' : '' %></span>
        <span class="niv-acc__chevron">▾</span>
      </summary>
      <div class="disc-grid">
        <% n.disciplines.forEach(function(d){ %>
          <div class="panel disc-tuile">
            <h3 class="disc-tuile__titre">📘 <%= d.nom %> <span class="badge badge--soft"><%= d.ressources.length %></span></h3>
            <div class="disc-tuile__liste">
            <% d.ressources.forEach(function(r){
                 var mime = r.mime || '';
                 var estVideo = mime.startsWith('video'), estAudio = mime.startsWith('audio');
                 var lienTelechargement = r.url + (r.url.indexOf('?') >= 0 ? '&' : '?') + 'download=1';
                 var taille = !r.taille ? '' : r.taille >= 1048576 ? (r.taille / 1048576).toFixed(1).replace('.', ',') + ' Mo' : Math.max(1, Math.round(r.taille / 1024)) + ' Ko';
                 var vues = r.vues || 0, telechargements = r.telechargements || 0; %>
              <div class="ress-carte ress-carte--tuile" data-ressource-id="<%= r.id %>">
          <h3 class="ress-carte__titre">
            <%= r.type === 'lien' ? '🔗' : estVideo ? '🎬' : estAudio ? '🎧' : mime.includes('pdf') ? '📄' : mime.startsWith('image') ? '🖼️' : '📁' %>
            <%= r.titre %>
          </h3>
          <% if (r.description) { %><p class="muted ress-carte__desc"><%= r.description %></p><% } %>
          <% if (estAudio) { %>
            <audio controls preload="none" src="<%= r.url %>" style="width:100%;"></audio>
          <% } %>
          <% if (estVideo) { %>
            <video controls preload="metadata" src="<%= r.url %>" style="width:100%; border-radius:8px; background:#000;"></video>
          <% } %>
          <div class="ress-carte__actions">
            <% if (r.type === 'lien') { %>
              <a class="btn btn--primary btn--sm" href="<%= r.url %>" target="_blank" rel="noopener" data-stat="vue">Ouvrir</a>
            <% } else if (estVideo) { %>
              <a class="btn btn--primary btn--sm" href="<%= r.url %>" target="_blank" rel="noopener" data-stat="vue">Plein écran</a>
              <a class="btn btn--ghost btn--sm" href="<%= lienTelechargement %>" download data-stat="telechargement">⬇️ Télécharger<% if (taille) { %> <span class="ress-carte__taille">(<%= taille %>)</span><% } %></a>
            <% } else if (estAudio) { %>
              <a class="btn btn--primary btn--sm" href="<%= lienTelechargement %>" download data-stat="telechargement">⬇️ Télécharger<% if (taille) { %> <span class="ress-carte__taille">(<%= taille %>)</span><% } %></a>
            <% } else { %>
              <a class="btn btn--primary btn--sm" href="<%= r.url %>" target="_blank" rel="noopener" data-stat="telechargement">Télécharger<% if (taille) { %> <span class="ress-carte__taille">(<%= taille %>)</span><% } %></a>
            <% } %>
            <% var chant = chantDe(r); %>
            <% if (chant) { %>
              <a class="btn btn--amber btn--sm" href="/ressources/chants/<%= chant.slug %>">🎯 Chanson &amp; quiz</a>
            <% } %>
              </div>
              <%# Compteurs de fréquentation de la ressource (mis à jour par ressources-stats.js) %>
              <p class="ress-carte__stats">
                <span title="Lectures et ouvertures de cette ressource">👁️
                  <b data-stat-val="vue" data-n="<%= vues %>"><%= nombreFr(vues) %></b>
                  <span data-stat-lib="vue" data-singulier="consultation" data-pluriel="consultations"><%= vues > 1 ? 'consultations' : 'consultation' %></span></span>
                <% if (r.type !== 'lien') { %>
                  <span title="Téléchargements de cette ressource">⬇️
                    <b data-stat-val="telechargement" data-n="<%= telechargements %>"><%= nombreFr(telechargements) %></b>
                    <span data-stat-lib="telechargement" data-singulier="téléchargement" data-pluriel="téléchargements"><%= telechargements > 1 ? 'téléchargements' : 'téléchargement' %></span></span>
                <% } %>
              </p>
              </div>
            <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </details>
  <% }) %>

  <div class="panel" style="margin-top: 24px; display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
    <div style="flex: 1 1 320px;">
      <h3 style="font-family: var(--font-title); font-size: 17px; margin: 0 0 6px;">💛 Cette banque vit grâce à vous</h3>
      <p class="muted" style="margin:0;">Les ressources sont offertes à tous. Si elles vous sont utiles, un don — même modeste —
        nous aide à en produire de nouvelles (fiches, corrigés, chansons, audio…).</p>
    </div>
    <a href="/dons" class="btn btn--amber">💛 Faire un don</a>
  </div>
</section>
<script src="/js/ressources-stats.js?v=<%= v('js/ressources-stats.js') %>" defer></script>
