<%# Banque de ressources didactiques — barre latérale des cycles (primaire,
    1er et 2nd cycles secondaires, supérieur) ; pour le cycle choisi, accordéons
    par niveau puis par discipline, clips dans chaque discipline.
    Locals : niveaux, cycles [{id, nom, sous, icone, niveaux, total}], autresNiveaux,
    cycleActif, stats {consultations, vues, telechargements}, nombreFr, chantDe, auteursDe %>
<section class="container space">
  <div class="banque-layout">
  <div class="banque-tete">
  <div class="space__head">
    <div>
      <h1 class="space__title">📚 Banque de ressources didactiques</h1>
      <p class="space__sub">Des ressources gratuites pour apprendre et réviser, classées par cycle et par niveau — sélectionnées par l'équipe EduWeb.</p>
    </div>
    <a href="/dons" class="btn btn--primary btn--sm">💛 Soutenir la banque</a>
  </div>

  <%# Fréquentation de la banque : visites de la page, consultations et téléchargements cumulés %>
  <div class="banque-stats" role="group" aria-label="Fréquentation de la banque de ressources">
    <div class="banque-stats__item">
      <span class="banque-stats__val">👁️ <%= nombreFr(stats.consultations) %></span>
      <span class="banque-stats__lib">visite<%= stats.consultations > 1 ? 's' : '' %> de la banque</span>
    </div>
    <div class="banque-stats__item">
      <span class="banque-stats__val">▶️ <%= nombreFr(stats.vues) %></span>
      <span class="banque-stats__lib">consultation<%= stats.vues > 1 ? 's' : '' %> de ressources</span>
    </div>
    <div class="banque-stats__item">
      <span class="banque-stats__val">⬇️ <%= nombreFr(stats.telechargements) %></span>
      <span class="banque-stats__lib">téléchargement<%= stats.telechargements > 1 ? 's' : '' %></span>
    </div>
  </div>

  <div class="info-banner info-banner--warn">
    <span>⚠️</span>
    <p style="margin:0;"><strong>Attention :</strong> l'ordre des leçons pourrait ne pas être le même que celui du livre
    ou de la progression affichée dans votre cahier de texte. Fiez-vous plutôt aux <strong>titres</strong> pour évoluer
    dans votre apprentissage, selon l'ordre officiel de progression en vigueur dans votre établissement.</p>
  </div>

  <div class="editions__loterie" style="background: var(--panel-bg, #fff); color: inherit; border-color: rgba(14,107,58,.25);">
    <div class="editions__loterie-txt">
      <strong>🎵 Les chansons des annales</strong> — apprenez en chantant : chaque annale EduWeb Éditions
      offre ses chansons mnémotechniques, débloquées par le code unique du livre.
    </div>
    <a class="btn btn--ghost" href="/chansons">🎵 Ouvrir les chansons</a>
  </div>
  </div>

  <%# Barre latérale : un bouton par cycle. Ce sont de vrais liens (?cycle=…) :
      sans JavaScript, la page se recharge sur le cycle choisi ; avec, le cycle
      s'affiche sans rechargement (public/js/ressources-cycles.js). %>
  <nav class="banque-cycles" aria-label="Cycles d’enseignement">
    <p class="banque-cycles__titre">Choisis ton cycle</p>
    <% cycles.forEach(function(c){ var actif = c.id === cycleActif; %>
      <a class="cycle-btn<%= actif ? ' is-actif' : '' %>" href="/ressources?cycle=<%= c.id %>" data-cycle="<%= c.id %>"<%- actif ? ' aria-current="true"' : '' %>>
        <span class="cycle-btn__icone" aria-hidden="true"><%= c.icone %></span>
        <span class="cycle-btn__texte">
          <span class="cycle-btn__nom"><%= c.nom %></span>
          <span class="cycle-btn__sous"><%= c.sous %></span>
          <span class="cycle-btn__compte"><%= c.total ? c.total + ' ressource' + (c.total > 1 ? 's' : '') : 'Bientôt' %></span>
        </span>
      </a>
    <% }) %>
  </nav>

  <div class="banque-corps">
  <% if (!niveaux.length) { %>
    <div class="panel"><div class="empty">📚<p>La banque se remplit bientôt — repassez très vite !</p></div></div>
  <% } %>

  <%# Un panneau par cycle ; seul le cycle choisi est visible. Accordéons par
      niveau (classés dans le cycle), tous repliés par défaut ; ouvrir un
      accordéon referme les autres du même rang (attribut name + repli JS) : tous les
      accordéons de niveau, cycles et « Autres niveaux », forment un seul groupe. %>
  <% var rangNiv = 0, groupeNiv = 'niv-banque'; %>
  <% cycles.forEach(function(c){ %>
    <div class="cycle-panel" id="cycle-<%= c.id %>" data-cycle-panel="<%= c.id %>"<%= c.id === cycleActif ? '' : ' hidden' %>>
      <h2 class="cycle-panel__titre" tabindex="-1"><span aria-hidden="true"><%= c.icone %></span> <%= c.nom %> <span class="cycle-panel__sous"><%= c.sous %></span></h2>
      <% if (!c.niveaux.length) { %>
        <div class="panel"><div class="empty"><%= c.icone %><p>Les ressources du <%= c.nom.charAt(0).toLowerCase() + c.nom.slice(1) %> arrivent bientôt — repassez très vite !</p></div></div>
      <% } %>
      <% c.niveaux.forEach(function(n){ rangNiv += 1; %>
        <%- include('partials/banque-niveau', { n: n, groupe: groupeNiv, rangNiv: rangNiv }) %>
      <% }) %>
    </div>
  <% }) %>

  <% if (autresNiveaux.length) { %>
    <div class="cycle-panel cycle-panel--autres">
      <h2 class="cycle-panel__titre"><span aria-hidden="true">📚</span> Autres niveaux</h2>
      <% autresNiveaux.forEach(function(n){ rangNiv += 1; %>
        <%- include('partials/banque-niveau', { n: n, groupe: groupeNiv, rangNiv: rangNiv }) %>
      <% }) %>
    </div>
  <% } %>

  <div class="panel" style="margin-top: 24px; display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
    <div style="flex: 1 1 320px;">
      <h3 style="font-family: var(--font-title); font-size: 17px; margin: 0 0 6px;">💛 Cette banque vit grâce à vous</h3>
      <p class="muted" style="margin:0;">Les ressources sont offertes à tous. Si elles vous sont utiles, un don — même modeste —
        nous aide à en produire de nouvelles (fiches, corrigés, chansons, audio…).</p>
    </div>
    <a href="/dons" class="btn btn--amber">💛 Faire un don</a>
  </div>
  </div>
  </div>
</section>
<script src="/js/ressources-stats.js?v=<%= v('js/ressources-stats.js') %>" defer></script>
<script src="/js/ressources-cycles.js?v=<%= v('js/ressources-cycles.js') %>" defer></script>
