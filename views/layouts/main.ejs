<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'fr' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="EduWeb — Plateforme de mise en relation entre familles et coachs scolaires en Côte d'Ivoire.">
  <title><%= title %></title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Drapeaux SVG -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/css/flag-icons.min.css">

  <!-- Leaflet (cartographie) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

  <link rel="stylesheet" href="/css/style.css?v=<%= v('css/style.css') %>">
  <link rel="icon" href="/images/logo.svg" type="image/svg+xml">

  <!-- PWA (application installable) -->
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#1E9E57">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="EduWeb">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
</head>
<body class="<%= bodyClass %>">

  <% if (!hideChrome) { %>
    <%- include('../partials/header') %>
  <% } %>

  <% if (locals.mt && locals.mm) { %>
    <div class="flash-wrap" id="flash">
      <div class="flash flash--<%= mt %>">
        <span class="flash__icon"><%- icon(mt === 'success' ? 'check' : mt === 'error' ? 'x' : 'bell', 18) %></span>
        <span><%- mm %></span>
        <button class="flash__close" onclick="document.getElementById('flash').remove()" aria-label="Fermer">&times;</button>
      </div>
    </div>
  <% } %>

  <main class="main">
    <%- body %>
  </main>

  <% if (!hideChrome) { %>
    <%- include('../partials/footer') %>
  <% } %>

  <% if (currentUser && !currentPath.startsWith('/messages') && currentPath !== '/guides') { %>
    <a href="/guides" class="help-fab <%= currentPath === '/' ? 'help-fab--raised' : '' %>" aria-label="Aide" title="<%= currentUser.isSuperAdmin ? 'Guides d\'utilisation' : 'Guide d\'utilisation' %>">
      <%- icon('book', 22) %><span class="help-fab__label"><%= t('fab.help') %></span>
    </a>
  <% } %>

  <% if (currentPath === '/') { %>
    <a href="https://booking.eduweb.ci/certel/diagnostic" class="certel-fab" target="_blank" rel="noopener"
       aria-label="<%= t('fab.certelTitle') %> — CERTEL">
      <span class="certel-fab__icon"><%- icon('graduation', 20) %></span>
      <span class="certel-fab__text">
        <span class="certel-fab__title"><%= t('fab.certelTitle') %></span>
        <span class="certel-fab__sub"><%= t('fab.certelSub') %></span>
      </span>
    </a>
  <% } %>

  <% /* Widget festif « 66e anniversaire de l'indépendance de la Côte d'Ivoire » — accueil, jusqu'au 7 sept. 2026 */ %>
  <% if (currentPath === '/' && new Date() < new Date('2026-09-08T00:00:00Z')) { %>
    <div id="ci66" class="ci66" role="img" aria-label="66e anniversaire de l'indépendance de la Côte d'Ivoire — Bonne fête !">
      <button type="button" class="ci66__close" aria-label="Fermer">&times;</button>
      <div class="ci66__fx" aria-hidden="true"></div>
      <img class="ci66__img" src="/celebration/fete-independance-ci-2026.webp" draggable="false"
           alt="66e anniversaire de l'indépendance de la Côte d'Ivoire — 7 août 1960 – 7 août 2026 — Bonne fête de l'Indépendance !">
    </div>
    <script>
    (function () {
      var w = document.getElementById('ci66');
      if (!w) return;
      try { if (localStorage.getItem('ci66_closed') === '1') { w.remove(); return; } } catch (e) {}
      // Fermeture (mémorisée)
      w.querySelector('.ci66__close').addEventListener('click', function (e) {
        e.stopPropagation();
        try { localStorage.setItem('ci66_closed', '1'); } catch (e2) {}
        w.style.transition = 'opacity .3s'; w.style.opacity = '0';
        setTimeout(function () { w.remove(); }, 300);
      });
      // Déplacement (souris + tactile) sur toute la surface de l'écran
      var drag = false, moved = false, sx, sy, ox, oy;
      function pt(e) { return e.touches ? e.touches[0] : e; }
      function start(e) {
        if (e.target.closest('.ci66__close')) return;
        var r = w.getBoundingClientRect(), p = pt(e);
        w.style.left = r.left + 'px'; w.style.top = r.top + 'px';
        w.style.right = 'auto'; w.style.bottom = 'auto'; w.style.transform = 'none';
        drag = true; moved = false; sx = p.clientX; sy = p.clientY; ox = r.left; oy = r.top;
        document.body.style.userSelect = 'none';
      }
      function move(e) {
        if (!drag) return;
        var p = pt(e), dx = p.clientX - sx, dy = p.clientY - sy;
        if (Math.abs(dx) + Math.abs(dy) > 4) moved = true;
        var nl = Math.min(Math.max(0, ox + dx), Math.max(0, window.innerWidth - w.offsetWidth));
        var nt = Math.min(Math.max(0, oy + dy), Math.max(0, window.innerHeight - w.offsetHeight));
        w.style.left = nl + 'px'; w.style.top = nt + 'px';
        if (e.cancelable) e.preventDefault();
      }
      function end() { drag = false; document.body.style.userSelect = ''; }
      w.addEventListener('mousedown', start); window.addEventListener('mousemove', move); window.addEventListener('mouseup', end);
      w.addEventListener('touchstart', start, { passive: true }); window.addEventListener('touchmove', move, { passive: false }); window.addEventListener('touchend', end);
      // Feux d'artifice au survol (couleurs du drapeau ivoirien + or)
      var fx = w.querySelector('.ci66__fx'), timer = null;
      var colors = ['#F77F00', '#ffffff', '#009E60', '#FFD100'];
      function burst() {
        var cx = w.offsetWidth / 2, cy = w.offsetHeight / 2;
        for (var i = 0; i < 14; i++) {
          var s = document.createElement('span'); s.className = 'ci66__spark';
          var a = Math.random() * Math.PI * 2, d = 42 + Math.random() * 66;
          s.style.setProperty('--tx', (Math.cos(a) * d).toFixed(1) + 'px');
          s.style.setProperty('--ty', (Math.sin(a) * d).toFixed(1) + 'px');
          s.style.left = cx + 'px'; s.style.top = cy + 'px';
          s.style.color = colors[i % colors.length]; s.style.background = colors[i % colors.length];
          fx.appendChild(s);
          (function (el) { setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 950); })(s);
        }
      }
      w.addEventListener('mouseenter', function () { if (drag) return; burst(); timer = setInterval(burst, 650); });
      w.addEventListener('mouseleave', function () { clearInterval(timer); timer = null; });
    })();
    </script>
  <% } %>

  <script>
    window.EDUWEB_COUNTRIES = <%- JSON.stringify(countryGroups) %>;
    window.EDUWEB_DIALCODES = <%- JSON.stringify(dialCodes) %>;
    window.EDUWEB_EUR_RATE = <%= APP.EUR_RATE %>;
    window.EDUWEB_I18N = { perMonth: <%- JSON.stringify(t('cdash.perMonth')) %>, you: <%- JSON.stringify(t('cprofil.you')) %>, tocTitle: <%- JSON.stringify(t('toc.title')) %> };
  </script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/js/app.js?v=<%= v('js/app.js') %>"></script>
  <script src="/js/country-picker.js?v=<%= v('js/country-picker.js') %>"></script>
  <script src="/js/zone-intervention.js?v=<%= v('js/zone-intervention.js') %>"></script>

  <!-- PWA : enregistrement du service worker + mise à jour automatique -->
  <script>
    if ('serviceWorker' in navigator) {
      (function () {
        var hadController = !!navigator.serviceWorker.controller;
        var refreshing = false;
        // Quand un nouveau service worker prend le contrôle, on recharge une fois
        // pour afficher la version à jour (sauf à la toute première installation).
        navigator.serviceWorker.addEventListener('controllerchange', function () {
          if (refreshing) return;
          refreshing = true;
          if (hadController) window.location.reload();
        });
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').then(function (reg) {
            // Recherche de mise à jour à l'ouverture, puis périodiquement
            // (utile pour l'app installée ou un onglet resté ouvert longtemps).
            reg.update().catch(function () {});
            setInterval(function () { reg.update().catch(function () {}); }, 60 * 1000);
          }).catch(function (err) {
            console.warn('SW registration failed:', err);
          });
        });
      })();
    }
  </script>
</body>
</html>
