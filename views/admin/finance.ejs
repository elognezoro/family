<section class="container space">
  <div class="space__head">
    <div>
      <h1 class="space__title"><%- icon('cash', 26) %> Finance &amp; parrainage</h1>
      <p class="space__sub">RAR, rétrocessions, versements, antifraude, politique commerciale et simulateur</p>
    </div>
    <div style="display:flex; gap:8px;">
      <a href="/admin/finance/export.csv" class="btn btn--ghost btn--sm"><%- icon('download', 14) %> Export CSV</a>
      <a href="/admin/finance/ledger.csv" class="btn btn--ghost btn--sm"><%- icon('download', 14) %> Ledger CSV</a>
      <button type="button" class="btn btn--ghost btn--sm" onclick="window.print()">Imprimer</button>
      <a href="/admin" class="btn btn--ghost btn--sm">← Tableau de bord</a>
    </div>
  </div>

  <% if (!d.dispo) { %>
    <div class="panel"><div class="info-banner info-banner--warn"><%- icon('clock', 16) %> Le moteur financier n'est pas encore migré (tables absentes). Appliquez la migration puis rechargez cette page.</div></div>
  <% } else { %>

    <!-- Alertes (§30) -->
    <% d.alertes.forEach(function(a){ %>
      <div class="info-banner <%= a.niveau === 'rouge' ? 'info-banner--warn' : '' %>">⚠️ <%= a.texte %></div>
    <% }) %>

    <!-- KPI (§20-§22) -->
    <% var k = d.kpis; var feux = { vert: '🟢', orange: '🟠', rouge: '🔴' }; %>
    <div class="stats-row">
      <div class="panel stat"><strong><%= feux[k.rarStatut] %> <%= k.rarMoyen.toLocaleString('fr-FR') %></strong><span>RAR moyen / abonné (cible <%= k.rarCible.toLocaleString('fr-FR') %>)</span></div>
      <div class="panel stat"><strong><%= APP.formatFCFA(k.rar) %></strong><span>RAR total</span></div>
      <div class="panel stat"><strong><%= APP.formatFCFA(k.caFacial) %></strong><span>CA facial</span></div>
      <div class="panel stat"><strong><%= APP.formatFCFA(k.encaissements) %></strong><span>Encaissements</span></div>
      <div class="panel stat"><strong><%= APP.formatFCFA(k.reductions) %></strong><span>Réductions accordées</span></div>
      <div class="panel stat"><strong><%= APP.formatFCFA(k.retroAcquises) %></strong><span>Rétrocessions acquises</span></div>
      <div class="panel stat"><strong><%= APP.formatFCFA(k.retroPayees) %></strong><span>Rétrocessions versées</span></div>
      <div class="panel stat"><strong><%= APP.formatFCFA(k.engagementsRestants) %></strong><span>Engagements restant dus</span></div>
      <div class="panel stat"><strong><%= k.abonnesPayants %></strong><span>Abonnés payants</span></div>
      <div class="panel stat"><strong><%= k.referralCac.toLocaleString('fr-FR') %></strong><span>CAC parrainage (FCFA)</span></div>
      <div class="panel stat"><strong><%= k.coefK %></strong><span>Coefficient K (<%= k.proportionParrains %> % parrainent · <%= k.moyenneFilleuls %> filleuls/parrain)</span></div>
    </div>

    <!-- Graphiques (§29) -->
    <% if (d.snapshots.length) { %>
      <div class="panel">
        <div class="panel__head"><h2>📈 Évolution (snapshots quotidiens)</h2></div>
        <div class="fin-charts">
          <div><canvas id="chRar"></canvas></div>
          <div><canvas id="chRetro"></canvas></div>
          <div><canvas id="chAbonnes"></canvas></div>
          <div><canvas id="chEngagements"></canvas></div>
        </div>
      </div>
    <% } else { %>
      <div class="panel"><p class="muted">Les graphiques apparaîtront après les premiers snapshots quotidiens (cron 23 h 30 UTC — ou déclenchez-en un : <code>/api/cron/profitability-snapshot</code>).</p></div>
    <% } %>

    <!-- Versements en attente (§15) -->
    <h2 class="section-title">💸 Versements à traiter (<%= d.payoutsAttente.length %>)</h2>
    <% if (!d.payoutsAttente.length) { %>
      <div class="panel"><p class="muted">Aucun versement en attente.</p></div>
    <% } else { %>
      <% d.payoutsAttente.forEach(function(p){ %>
        <div class="panel fadm-card">
          <div class="fadm-card__body">
            <strong><%= p.user.name %></strong> <span class="muted">(<%= p.user.email %>)</span>
            <div class="fadm-card__meta">
              <span class="badge badge--ok"><%= APP.formatFCFA(p.montant) %></span>
              <span class="badge badge--soft"><%= p.moyen %> → <%= p.numeroBeneficiaire %></span>
              <span class="muted">demandé le <%= new Date(p.requestedAt).toLocaleDateString('fr-FR') %></span>
              <% if (p.user.fraudStatus && p.user.fraudStatus !== 'NORMAL') { %><span class="badge badge--no">⚠️ statut fraude : <%= p.user.fraudStatus %></span><% } %>
            </div>
            <p class="muted" style="font-size:12.5px; margin:6px 0 0;">Envoyez <%= APP.formatFCFA(p.montant) %> via <%= p.moyen %> au <%= p.numeroBeneficiaire %>, puis enregistrez la référence du transfert.</p>
          </div>
          <div class="fadm-card__actions" style="flex-direction:column; align-items:stretch; gap:6px;">
            <form action="/admin/finance/payout/<%= p.id %>/regler" method="POST" style="display:flex; gap:6px;">
              <input type="hidden" name="action" value="paye">
              <input type="text" name="reference" placeholder="Réf. du transfert" required style="width:150px;">
              <button type="submit" class="btn btn--primary btn--sm">Versé ✓</button>
            </form>
            <form action="/admin/finance/payout/<%= p.id %>/regler" method="POST" onsubmit="var m = prompt('Motif de l’échec :'); if (m === null) return false; this.motif.value = m; return true;" style="text-align:right;">
              <input type="hidden" name="action" value="echec">
              <input type="hidden" name="motif" value="">
              <button type="submit" class="btn btn--ghost btn--sm">Échec ✗</button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } %>

    <!-- Antifraude (§31) -->
    <h2 class="section-title">🛡️ Signaux antifraude à examiner (<%= d.fraudeAttente.length %>)</h2>
    <% if (!d.fraudeAttente.length) { %>
      <div class="panel"><p class="muted">Aucun signal en attente. 👍</p></div>
    <% } else { %>
      <% d.fraudeAttente.forEach(function(f){ var det = null; try { det = f.detail ? JSON.parse(f.detail) : null; } catch (e) {} %>
        <div class="panel fadm-card">
          <div class="fadm-card__body">
            <strong><%= f.user.name %></strong> <span class="muted">(<%= f.user.email %>)</span>
            <div class="fadm-card__meta">
              <span class="badge <%= f.severite === 'eleve' ? 'badge--no' : 'badge--soft' %>"><%= f.type.replace(/_/g, ' ') %> · <%= f.severite %></span>
              <% if (det && det.motif) { %><span class="muted"><%= det.motif %></span><% } %>
              <span class="muted">le <%= new Date(f.createdAt).toLocaleDateString('fr-FR') %></span>
            </div>
          </div>
          <div class="fadm-card__actions">
            <form action="/admin/finance/fraude/<%= f.id %>/decision" method="POST"><input type="hidden" name="decision" value="NORMAL"><button class="btn btn--ghost btn--sm">RAS</button></form>
            <form action="/admin/finance/fraude/<%= f.id %>/decision" method="POST"><input type="hidden" name="decision" value="SUSPICIOUS"><button class="btn btn--ghost btn--sm">Suspect</button></form>
            <form action="/admin/finance/fraude/<%= f.id %>/decision" method="POST" onsubmit="return confirm('Bloquer les rétrocessions et versements de ce compte ?');"><input type="hidden" name="decision" value="BLOCKED"><button class="btn btn--ghost btn--sm" style="color:var(--danger);">Bloquer</button></form>
          </div>
        </div>
      <% }) %>
    <% } %>

    <!-- Derniers abonnements (remboursement §16) -->
    <h2 class="section-title">🧾 Derniers abonnements</h2>
    <div class="panel" style="overflow-x:auto;">
      <table class="table">
        <thead><tr><th>Date</th><th>Abonné</th><th>Formule</th><th>Facial</th><th>Réduction</th><th>Payé</th><th>Statut</th><th></th></tr></thead>
        <tbody>
          <% d.subsRecentes.forEach(function(s){ %>
            <tr>
              <td class="muted"><%= new Date(s.createdAt).toLocaleDateString('fr-FR') %></td>
              <td><strong><%= s.user.name %></strong></td>
              <td><%= s.plan ? s.plan.nom : '—' %></td>
              <td><%= APP.formatFCFA(s.prixFacial) %></td>
              <td><%= s.reduction ? '−' + APP.formatFCFA(s.reduction) + (s.sourceReduction === 'parrainage' ? ' 🤝' : ' 🎟️') : '—' %></td>
              <td><strong><%= APP.formatFCFA(s.montantPaye) %></strong></td>
              <td><span class="badge <%= s.statut === 'active' ? 'badge--ok' : (s.statut === 'pending' ? 'badge--pending' : 'badge--no') %>"><%= s.statut %></span></td>
              <td>
                <% if (['active', 'expired'].includes(s.statut)) { %>
                  <form action="/admin/finance/rembourser/<%= s.id %>" method="POST" onsubmit="var m = prompt('Motif du remboursement (contre-écriture au parrain si rétrocession) :'); if (m === null) return false; this.motif.value = m; return true;">
                    <input type="hidden" name="motif" value="">
                    <button type="submit" class="btn btn--ghost btn--sm">Rembourser</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Politique commerciale (§2) -->
    <h2 class="section-title">⚙️ Politique commerciale — version <%= d.policy.version %></h2>
    <form action="/admin/finance/politique" method="POST" class="panel">
      <p class="muted" style="font-size:13px;">Chaque enregistrement crée une <strong>nouvelle version historisée</strong> : les transactions déjà réalisées ne sont jamais recalculées.</p>
      <div class="fadm-offre-form__grid">
        <div class="form-row"><label>Tarif facial de référence (FCFA)</label><input type="number" name="basePriceRef" value="<%= d.policy.basePriceRef %>" min="0"></div>
        <div class="form-row"><label>Réduction premiers filleuls (%)</label><input type="number" name="discountRate" value="<%= d.policy.discountRate %>" min="0" max="100"></div>
        <div class="form-row"><label>Rétrocession parrain (%)</label><input type="number" name="commissionRate" value="<%= d.policy.commissionRate %>" min="0" max="100"></div>
        <div class="form-row"><label>Places promotionnelles</label><input type="number" name="discountedReferralsLimit" value="<%= d.policy.discountedReferralsLimit %>" min="0" max="20"></div>
        <div class="form-row"><label>Plancher coût net (FCFA)</label><input type="number" name="minimumNetCost" value="<%= d.policy.minimumNetCost %>" min="0"></div>
        <div class="form-row"><label>TTL réservation place (heures)</label><input type="number" name="slotTtlHeures" value="<%= d.policy.slotTtlHeures %>" min="1"></div>
        <div class="form-row"><label>Versement minimum (FCFA)</label><input type="number" name="payoutMinimum" value="<%= d.policy.payoutMinimum %>" min="0"></div>
        <div class="form-row"><label>Plafond versement / jour (vide = aucun)</label><input type="number" name="payoutLimiteJour" value="<%= d.policy.payoutLimiteJour || '' %>" min="0"></div>
        <div class="form-row"><label>Plafond versement / mois (vide = aucun)</label><input type="number" name="payoutLimiteMois" value="<%= d.policy.payoutLimiteMois || '' %>" min="0"></div>
        <div class="form-row"><label>Cible RAR moyen (FCFA)</label><input type="number" name="rarCibleMoyen" value="<%= d.policy.rarCibleMoyen %>" min="0"></div>
        <div class="form-row"><label>Seuil orange (% de la cible)</label><input type="number" name="rarSeuilOrangePct" value="<%= d.policy.rarSeuilOrangePct %>" min="0" max="100"></div>
      </div>
      <button type="submit" class="btn btn--primary btn--sm">Enregistrer (nouvelle version v<%= d.policy.version + 1 %>)</button>
    </form>

    <!-- Simulateur (§26-§28) -->
    <h2 class="section-title">🧮 Simulateur de rentabilité</h2>
    <div class="panel">
      <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:10px;">
        <span class="muted" style="font-size:13px;">Volumes rapides :</span>
        <% [1000, 5000, 10000, 50000, 100000].forEach(function(n){ %>
          <button type="button" class="btn btn--ghost btn--sm" onclick="document.getElementById('sim_nb').value = <%= n %>; simuler();"><%= n.toLocaleString('fr-FR') %></button>
        <% }) %>
        <button type="button" class="btn btn--ghost btn--sm" onclick="chargerScenario10000()">Scénario de référence (10 000)</button>
      </div>
      <form id="simForm" class="fadm-offre-form__grid" onsubmit="simuler(); return false;">
        <div class="form-row"><label>Abonnés</label><input type="number" id="sim_nb" name="nbAbonnes" value="<%= scenarioDefaut.nbAbonnes %>"></div>
        <div class="form-row"><label>Prix facial</label><input type="number" name="prixFacial" value="<%= scenarioDefaut.prixFacial %>"></div>
        <div class="form-row"><label>% issus du parrainage</label><input type="number" name="pctIssusParrainage" value="<%= scenarioDefaut.pctIssusParrainage %>" step="0.1"></div>
        <div class="form-row"><label>Taux de réduction (%)</label><input type="number" name="tauxReduction" value="<%= scenarioDefaut.tauxReduction %>" step="0.1"></div>
        <div class="form-row"><label>Filleuls avec réduction</label><input type="number" name="nbFilleulsReduits" value="<%= scenarioDefaut.nbFilleulsReduits %>"></div>
        <div class="form-row"><label>Taux de rétrocession (%)</label><input type="number" name="tauxRetrocession" value="<%= scenarioDefaut.tauxRetrocession %>" step="0.1"></div>
        <div class="form-row"><label>Plancher (FCFA)</label><input type="number" name="plancher" value="<%= scenarioDefaut.plancher %>"></div>
        <div class="form-row"><label>Rétrocessions estimées (vide = auto)</label><input type="number" name="retrocessionsEstimees" value="<%= scenarioDefaut.retrocessionsEstimees %>"></div>
        <div class="form-row"><label>Frais de paiement (%)</label><input type="number" name="fraisPaiementPct" value="<%= scenarioDefaut.fraisPaiementPct %>" step="0.1"></div>
        <div class="form-row"><label>Commissions externes (FCFA)</label><input type="number" name="commissionsExternes" value="0"></div>
        <div class="form-row"><label>Coûts variables (FCFA)</label><input type="number" name="coutsVariables" value="0"></div>
        <div class="form-row"><label>Charges fixes (FCFA)</label><input type="number" name="chargesFixes" value="<%= scenarioDefaut.chargesFixes %>"></div>
        <div class="form-row"><label>Nom (pour enregistrer)</label><input type="text" name="nomScenario" placeholder="facultatif"></div>
        <div class="form-row" style="display:flex; align-items:flex-end; gap:8px;">
          <button type="submit" class="btn btn--primary btn--sm">Simuler</button>
          <button type="button" class="btn btn--ghost btn--sm" onclick="simuler(true)">Simuler + enregistrer</button>
        </div>
      </form>
      <div id="simResultats" hidden>
        <div class="stats-row" style="margin-top:14px;" id="simCartes"></div>
        <p class="muted" style="font-size:12.5px;">⚠️ Résultat contributif <strong>indicatif</strong> : il n'intègre que les charges saisies ci-dessus — ce n'est pas un bénéfice comptable réel.</p>
      </div>
    </div>
  <% } %>
</section>

<% if (d.dispo && d.snapshots.length) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  var SNAPS = <%- JSON.stringify(d.snapshots.map(function(s){ return { j: new Date(s.jour).toISOString().slice(5, 10), rar: s.rarMoyen, retroA: s.retroAcquises, retroP: s.retroPayees, red: s.reductions, ca: s.caFacial, enc: s.encaissements, ab: s.abonnesActifs, nv: s.nouveauxAbonnes, eng: s.engagementsRestants, k: s.coefK }; })).replace(/</g, '\\u003c') %>;
  var L = SNAPS.map(function (s) { return s.j; });
  function ligne(id, titre, jeux) {
    new Chart(document.getElementById(id), {
      type: 'line',
      data: { labels: L, datasets: jeux.map(function (d, i) { return { label: d.l, data: d.v, borderColor: d.c, backgroundColor: d.c + '22', tension: .3, fill: false }; }) },
      options: { plugins: { title: { display: true, text: titre } }, scales: { y: { beginAtZero: true } } },
    });
  }
  ligne('chRar', 'CA facial / Encaissements / RAR', [
    { l: 'CA facial', v: SNAPS.map(function(s){return s.ca;}), c: '#7A8A7A' },
    { l: 'Encaissements', v: SNAPS.map(function(s){return s.enc;}), c: '#1E9E57' },
    { l: 'RAR', v: SNAPS.map(function(s){return s.enc - s.retroA;}), c: '#0E6B3A' },
  ]);
  ligne('chRetro', 'Réductions vs rétrocessions (dues / payées)', [
    { l: 'Réductions', v: SNAPS.map(function(s){return s.red;}), c: '#F08A24' },
    { l: 'Rétrocessions acquises', v: SNAPS.map(function(s){return s.retroA;}), c: '#DC3545' },
    { l: 'Rétrocessions payées', v: SNAPS.map(function(s){return s.retroP;}), c: '#2563EB' },
  ]);
  ligne('chAbonnes', 'Abonnés actifs / nouveaux / coefficient K', [
    { l: 'Actifs', v: SNAPS.map(function(s){return s.ab;}), c: '#1E9E57' },
    { l: 'Nouveaux', v: SNAPS.map(function(s){return s.nv;}), c: '#F08A24' },
    { l: 'K ×100', v: SNAPS.map(function(s){return Math.round(s.k * 100);}), c: '#7C5CFC' },
  ]);
  ligne('chEngagements', 'RAR moyen / engagements restants', [
    { l: 'RAR moyen', v: SNAPS.map(function(s){return s.rar;}), c: '#0E6B3A' },
    { l: 'Engagements dus', v: SNAPS.map(function(s){return s.eng;}), c: '#DC3545' },
  ]);
</script>
<% } %>
<% if (d.dispo) { %>
<script>
  function chargerScenario10000() {
    var s = <%- JSON.stringify(scenarioDefaut).replace(/</g, '\\u003c') %>;
    var f = document.getElementById('simForm');
    Object.keys(s).forEach(function (k) { if (f.elements[k]) f.elements[k].value = s[k]; });
    simuler();
  }
  function simuler(enregistrer) {
    var f = document.getElementById('simForm');
    var body = new URLSearchParams(new FormData(f));
    if (enregistrer) body.set('enregistrer', '1');
    fetch('/admin/finance/simuler', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' }, body: body })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var r = data.resultats;
        var fmt = function (n) { return Number(n).toLocaleString('fr-FR') + ' FCFA'; };
        var cartes = [
          ['CA facial', fmt(r.caFacial)], ['Réductions', fmt(r.reductions)], ['Encaissements', fmt(r.encaissements)],
          ['Rétrocessions', fmt(r.retrocessions)], ['RAR', fmt(r.rar)], ['RAR moyen', Math.round(r.rarMoyen).toLocaleString('fr-FR') + ' FCFA/abonné'],
          ['Frais de paiement', fmt(r.fraisPaiement)], ['Marge contributive', fmt(r.margeContributive)],
          ['Résultat contributif indicatif', fmt(r.resultatContributif)], ['Taux de conservation', Math.round(r.tauxConservation) + ' % du CA facial'],
        ];
        document.getElementById('simCartes').innerHTML = cartes.map(function (c) {
          return '<div class="panel stat"><strong>' + c[1] + '</strong><span>' + c[0] + '</span></div>';
        }).join('');
        document.getElementById('simResultats').hidden = false;
      })
      .catch(function () { alert('Simulation impossible.'); });
  }
</script>
<% } %>
