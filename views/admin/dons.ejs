<section class="container space">
  <div class="space__head">
    <div>
      <h1 class="space__title">💛 Dons — banque de ressources</h1>
      <p class="space__sub">Versements déclarés sur <a href="/dons" target="_blank">/dons</a> — vérifiez le relevé mobile money avant de confirmer.</p>
    </div>
    <div style="display:flex; gap:8px;">
      <a href="/admin/dons/export.csv" class="btn btn--ghost btn--sm">⬇️ Export CSV</a>
      <a href="/admin" class="btn btn--ghost btn--sm">← Tableau de bord</a>
    </div>
  </div>

  <div class="stats-row">
    <div class="panel stat"><strong><%= totaux.confirme.toLocaleString('fr-FR') %> F</strong><span>dons confirmés</span></div>
    <div class="panel stat"><strong><%= totaux.declare.toLocaleString('fr-FR') %> F</strong><span>en attente de vérification</span></div>
  </div>

  <% if (!dons.length) { %>
    <div class="info-banner">ℹ️ Aucun don déclaré pour le moment. Partagez le lien <a href="/dons" target="_blank">family.eduweb.ci/dons</a> !</div>
  <% } else { %>
    <div class="panel" style="overflow-x:auto;">
      <table class="table">
        <thead><tr><th>Date</th><th>Donateur</th><th>Montant</th><th>Versement</th><th>Message</th><th>Statut</th><th></th></tr></thead>
        <tbody>
          <% var stB = { declare: 'badge--soft', confirme: 'badge--ok', rejete: 'badge--no' }; %>
          <% var stL = { declare: 'À vérifier', confirme: 'Confirmé', rejete: 'Rejeté' }; %>
          <% dons.forEach(function(d){ %>
            <tr>
              <td class="muted" style="white-space:nowrap;"><%= new Date(d.createdAt).toLocaleDateString('fr-FR') %></td>
              <td><strong><%= d.nom %></strong>
                <% if (d.telephone) { %><br><a href="tel:<%= d.telephone %>"><%= d.telephone %></a><% } %>
                <% if (d.email) { %><br><span class="muted"><%= d.email %></span><% } %></td>
              <td style="white-space:nowrap;"><strong><%= d.montant.toLocaleString('fr-FR') %> F</strong></td>
              <td>📱 <%= d.operateur %><br><span class="muted" style="word-break:break-all;">réf. <%= d.refTransaction %></span></td>
              <td class="muted"><%= d.message || '—' %></td>
              <td><span class="badge <%= stB[d.statut] || 'badge--soft' %>"><%= stL[d.statut] || d.statut %></span>
                <% if (d.noteAdmin) { %><br><span class="muted">📝 <%= d.noteAdmin %></span><% } %></td>
              <td style="white-space:nowrap;">
                <% if (d.statut === 'declare') { %>
                  <form action="/admin/dons/<%= d.id %>/statut" method="POST" style="display:inline"><input type="hidden" name="statut" value="confirme"><button type="submit" class="btn btn--primary btn--sm">Argent reçu ✓</button></form>
                  <form action="/admin/dons/<%= d.id %>/statut" method="POST" style="display:inline"
                        onsubmit="return confirm('Rejeter le don déclaré par <%= d.nom %> ?')">
                    <input type="hidden" name="statut" value="rejete"><button type="submit" class="btn btn--ghost btn--sm">Rejeter</button></form>
                <% } else { %>
                  <form action="/admin/dons/<%= d.id %>/statut" method="POST" style="display:inline"><input type="hidden" name="statut" value="declare"><button type="submit" class="btn btn--ghost btn--sm">Revérifier</button></form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <div class="info-banner">💡 Comme pour la Formation : ne confirmez qu'après avoir vu l'argent sur le relevé mobile money (montant + référence). Le total confirmé s'affiche sur la page publique des dons.</div>
</section>
