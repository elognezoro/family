<%# Épreuve chronométrée : toutes les questions sur une page, SANS corrigé
    (la correction est faite par le serveur). Locals : competition, epreuve,
    competiteur, questions (sans corrigé), restantMs, comp %>
<section class="container space space--narrow">
  <div class="space__head">
    <div>
      <span class="badge badge--soft"><%= competition.titre %></span>
      <h1 class="space__title" style="margin-top:6px;">⏱️ <%= epreuve.chant.titre %></h1>
      <p class="space__sub"><%= epreuve.chant.discipline %> · <%= epreuve.chant.niveau %> · <%= questions.length %> questions · <%= Math.round(epreuve.dureeSec / 60) %> min</p>
    </div>
  </div>

  <div class="comp-chrono" id="compChrono" data-restant="<%= restantMs %>" data-duree="<%= epreuve.dureeSec * 1000 %>">
    <div class="comp-chrono__txt">⏱️ Temps restant : <strong id="compChronoTxt">--:--</strong></div>
    <div class="quiz-barre"><div class="quiz-barre__remplie" id="compChronoBarre" style="width:100%;"></div></div>
    <p class="muted hint" style="margin:6px 0 0;">Réponds à toutes les questions puis clique sur « Remettre mes réponses ». À la fin du temps, tes réponses sont envoyées automatiquement.</p>
  </div>

  <form action="/competitions/<%= competition.slug %>/epreuve/<%= epreuve.slug %>" method="POST" id="compEpreuve" class="panel">
    <% questions.forEach(function(q, i){ %>
      <div class="quiz-q" data-type="<%= q.type %>">
        <p class="quiz-q__enonce"><strong>Q<%= i + 1 %>.</strong> <%= q.question %>
          <% if (q.type === 'qcm') { %><span class="badge badge--soft">plusieurs réponses</span><% } %>
          <% if (q.type === 'classement') { %><span class="badge badge--soft">clique dans l'ordre</span><% } %></p>
        <% if (q.image) { %>
          <img class="quiz-q__image" src="<%= q.image %>?v=<%= v(q.image.replace(/^\//, '')) %>" alt="<%= q.imageAlt || '' %>" loading="lazy">
        <% } %>
        <% if (q.type === 'qcu') { %>
          <div class="fniv-radio">
            <% q.options.forEach(function(opt, j){ %>
              <label class="check-pill"><input type="radio" name="q<%= i %>" value="<%= j %>"><span><%= opt %></span></label>
            <% }) %>
          </div>
        <% } else if (q.type === 'qcm') { %>
          <div class="fniv-radio">
            <% q.options.forEach(function(opt, j){ %>
              <label class="check-pill"><input type="checkbox" name="q<%= i %>" value="<%= j %>"><span><%= opt %></span></label>
            <% }) %>
          </div>
        <% } else if (q.type === 'vraifaux') { %>
          <div class="fniv-radio">
            <label class="check-pill"><input type="radio" name="q<%= i %>" value="vrai"><span>✅ Vrai</span></label>
            <label class="check-pill"><input type="radio" name="q<%= i %>" value="faux"><span>❌ Faux</span></label>
          </div>
        <% } else if (q.type === 'classement') { %>
          <div class="classement" data-classement>
            <div class="classement__items">
              <% q.items.forEach(function(item, j){ %>
                <button type="button" class="classement__item" data-j="<%= j %>"><span class="classement__rang" hidden></span><%= item %></button>
              <% }) %>
            </div>
            <button type="button" class="btn btn--ghost btn--sm classement__reset">↺ Refaire l'ordre</button>
            <input type="hidden" name="q<%= i %>" value="">
          </div>
        <% } else { %>
          <input type="text" name="q<%= i %>" maxlength="200" placeholder="Écris ta réponse ici…" autocomplete="off" style="width:100%;">
        <% } %>
      </div>
    <% }) %>
    <div class="comp-remise">
      <button type="submit" class="btn btn--primary btn--lg" id="compRemettre">🏁 Remettre mes réponses</button>
      <span class="muted hint">Une seule remise possible.</span>
    </div>
  </form>
</section>
<script src="/js/competition.js?v=<%= v('js/competition.js') %>" defer></script>
