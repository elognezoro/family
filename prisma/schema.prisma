// EduWeb — Family & Coaching · Schéma Prisma
//
// Base : PostgreSQL (Neon). Compatible local ET déploiement Vercel.
//  - DATABASE_URL : connexion POOLÉE (runtime serverless)
//  - DIRECT_URL   : connexion DIRECTE (migrations / db push)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  name              String
  gender            String? // "Femme" | "Homme"
  role              String    @default("parent") // parent | coach | commercial | admin
  isSuperAdmin      Boolean   @default(false) // super-admin : gère les autres admins
  permissions       String    @default("") // permissions admin (CSV) : users,coaches,finance
  referralCode      String?   @unique // code de parrainage unique
  referredById      String? // qui a parrainé cet utilisateur
  photo             String?
  phone             String?
  pays              String    @default("ci") // pays (code ISO 3166-1 alpha-2), choisi à l'inscription
  lang              String    @default("fr") // langue de lecture de l'app
  status            String    @default("active") // active | suspended
  emailVerified     Boolean   @default(false)
  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?
  resetToken        String?   @unique // réinitialisation du mot de passe
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  families         Family[]
  coachProfile     CoachProfile?
  payments         Payment[]      @relation("UserPayments")
  sentMissions     Mission[]      @relation("ParentMissions")
  receivedMissions Mission[]      @relation("CoachMissions")
  notifications    Notification[]
  referredBy       User?          @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]         @relation("Referrals")
  commissions      Commission[]   @relation("CommissionReferrer")
  sentMessages     Message[]      @relation("MsgSent")
  receivedMessages Message[]      @relation("MsgReceived")
  formationEnrollment FormationEnrollment? @relation("FormationUser")
  formationValidations FormationEnrollment[] @relation("FormationValidator")
  quizAttempts        QuizAttempt[]
  webauthnCredentials WebAuthnCredential[]
  fraudStatus         String   @default("NORMAL") // NORMAL | REVIEW | SUSPICIOUS | BLOCKED (§31)
  subscriptions       Subscription[]
  attributionsParrain ReferralAttribution[] @relation("AttributionsParrain")
  attributionFilleul  ReferralAttribution?  @relation("AttributionFilleul")
  promotionSlots      ReferralPromotionSlot[] @relation("SlotsParrain")
  wallet              FinancialWallet?
  ledgerEntries       FinancialLedgerEntry[]
  payouts             Payout[]
  fraudFlags          FraudFlag[]
}

// ─── Formation : tests psychotechniques ───

// Formule d'accès à la Formation — tarifs fixés par l'administrateur
model FormationOffre {
  id              String   @id @default(uuid())
  nom             String // ex. « Pack Découverte », « Pack Concours »
  description     String?
  prix            Int // FCFA
  dureeJours      Int? // null = accès illimité dans le temps
  quotaTentatives Int? // null = nombre de tests illimité
  actif           Boolean  @default(true)
  ordre           Int      @default(0)
  createdAt       DateTime @default(now())

  enrollments   FormationEnrollment[]
  subscriptions Subscription[]
}

// Inscription à la section Formation — payée OU autorisée, validée par un administrateur
model FormationEnrollment {
  id           String    @id @default(uuid())
  userId       String    @unique
  niveau       String    @default("bepc") // prebepc | bepc | superieur
  objectif     String? // concours visé (texte libre)
  statut       String    @default("pending") // pending | approuve | refuse
  accessType   String    @default("autorise") // paye | autorise
  offreId      String?
  operateur    String? // wave | orange | mtn | moov (paiement déclaré)
  refTransaction String? // référence du versement mobile money
  montantAttendu Int? // prix de la formule après réduction éventuelle
  promoCode    String?
  expiresAt    DateTime? // fin d'accès (approbation + dureeJours de la formule)
  subscriptionId String? // période d'abonnement courante (moteur financier)
  motifRefus   String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("FormationUser", fields: [userId], references: [id])
  approvedBy   User?     @relation("FormationValidator", fields: [approvedById], references: [id])
  offre        FormationOffre? @relation(fields: [offreId], references: [id])

  @@index([statut])
}

// Tentative de test (les questions et l'ordre des options sont figés au démarrage)
model QuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  categorie   String
  niveau      String
  mode        String    @default("entrainement") // entrainement (correction immédiate) | examen (chronométré)
  nbQuestions Int
  questions   String // JSON : [{id, options mélangées, index bonne réponse}]
  reponses    String    @default("{}") // JSON : { index question -> réponse choisie }
  score       Int?
  dureeSec    Int?
  tempsMaxSec Int? // budget total en mode examen
  statut      String    @default("en_cours") // en_cours | termine | abandonne
  statsJson   String? // JSON : détail par difficulté / sous-catégorie
  diagnostic  String? // JSON : diagnostic de performance + perspectives (IA)
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, categorie])
}

// Empreinte digitale / biométrie (WebAuthn) — vérification avant un test
model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique // base64url
  publicKey    String // clé publique COSE (base64url)
  counter      Int       @default(0)
  transports   String?
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SiteStat {
  id          String    @id @default("site")
  visits      Int       @default(0)
  purgeDays   Int       @default(30) // pièces jointes : suppression après N jours
  purgeHour   Int       @default(3) // heure UTC d'exécution préférée (0–23)
  lastPurgeAt DateTime? // dernière purge effectuée
}

// Instantanés périodiques des compteurs (graphique temps réel de l'accueil)
model StatPoint {
  id     Int      @id @default(autoincrement())
  ts     DateTime @default(now())
  visits Int
  users  Int

  @@index([ts])
}

model Message {
  id             String   @id @default(uuid())
  senderId       String
  recipientId    String
  body           String   @default("")
  attachmentUrl  String? // pièce jointe (≤ 1 Mo) : URL Blob ou data:base64
  attachmentName String?
  attachmentType String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
  sender      User     @relation("MsgSent", fields: [senderId], references: [id])
  recipient   User     @relation("MsgReceived", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId, read])
}

model Commission {
  id             String   @id @default(uuid())
  referrerUserId String
  refereeUserId  String
  missionId      String?
  type           String // parent_payment | coach_accept
  amount         Int      @default(0) // FCFA reversés au parrain
  paid           Boolean  @default(false) // commission réglée par EduWeb ?
  paidAt         DateTime? // date de règlement
  createdAt      DateTime @default(now())
  referrer       User     @relation("CommissionReferrer", fields: [referrerUserId], references: [id])

  @@unique([missionId, type])
}

model Family {
  id          String    @id @default(uuid())
  ownerUserId String
  label       String
  owner       User      @relation(fields: [ownerUserId], references: [id])
  learners    Learner[]
}

model Learner {
  id       String  @id @default(uuid())
  familyId String
  sexe     String? // "F" | "M"
  age      Int?
  pays     String  @default("ci")
  region   String?
  commune  String?
  quartier String?
  cycle    String? // prescolaire | primaire | secondaire1 | secondaire2_general | secondaire2_technique
  niveau   String? // CP1, 6e, Terminale, etc.
  serie    String? // A, C, D, G1, etc.

  family        Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  needs         Need[]
  carnetEntries CarnetEntry[]
  missions      Mission[]
}

model Need {
  id            String   @id @default(uuid())
  learnerId     String
  disciplineId  String
  heuresSemaine Int      @default(2)
  mode          String   @default("presentiel") // presentiel | visio | hybride
  createdAt     DateTime @default(now())
  learner       Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
}

model CoachProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  pays         String   @default("ci")
  zone         String?
  region       String?
  commune      String?
  quartier     String?
  adresse      String?
  gpsLat       Float?
  gpsLng       Float?
  presentation String?
  experience   String?
  statut       String   @default("pending") // pending | valide | refuse
  certifie     Boolean  @default(false)
  motifRefus   String?
  note         Float    @default(0)
  avisCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id])
  niveaux       CoachNiveau[]
  disciplines   CoachDiscipline[]
  modes         CoachMode[]
  documents     CoachDocument[]
  avis          Avis[]
  carnetEntries CarnetEntry[]
  missions      Mission[]
}

model CoachNiveau {
  id        String       @id @default(uuid())
  profileId String
  niveauId  String
  profile   CoachProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, niveauId])
}

model CoachDiscipline {
  id           String       @id @default(uuid())
  profileId    String
  disciplineId String
  tarifMensuel Int          @default(5000) // FCFA / HEURE (tarif horaire fixé par le coach)
  ordre        Int          @default(0) // priorité (0 = la plus haute) — discipline n°1 affichée sur l'accueil
  profile      CoachProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, disciplineId])
}

model CoachMode {
  id        String       @id @default(uuid())
  profileId String
  mode      String // presentiel | visio | hybride
  profile   CoachProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, mode])
}

model CoachDocument {
  id        String       @id @default(uuid())
  profileId String
  type      String // diplome | cni | cv | certificat
  filename  String
  url       String
  status    String       @default("pending")
  createdAt DateTime     @default(now())
  profile   CoachProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(uuid())
  parentUserId  String
  brut          Int      @default(0)
  remise        Int      @default(0)
  pct           Int      @default(0)
  promoCode     String?
  net           Int      @default(0)
  operateur     String? // wave | orange | mtn | moov
  transactionId String?
  createdAt     DateTime @default(now())
  parent        User     @relation("UserPayments", fields: [parentUserId], references: [id])
}

model Mission {
  id             String        @id @default(uuid())
  parentUserId   String
  coachProfileId String?
  coachUserId    String?
  learnerId      String?
  disciplineId   String?
  mode           String? // presentiel | visio | hybride
  heuresMois     Int? // engagement horaire mensuel facturé
  statut         String        @default("pending")
  montant        Int?
  createdAt      DateTime      @default(now())
  parent         User          @relation("ParentMissions", fields: [parentUserId], references: [id])
  coach          User?         @relation("CoachMissions", fields: [coachUserId], references: [id])
  coachProfile   CoachProfile? @relation(fields: [coachProfileId], references: [id])
  learner        Learner?      @relation(fields: [learnerId], references: [id])
}

model PromoCode {
  code       String    @id
  pct        Int
  actif      Boolean   @default(true)
  usageMax   Int?
  usageCount Int       @default(0)
  expiration DateTime?
}

model CarnetEntry {
  id             String       @id @default(uuid())
  learnerId      String
  disciplineId   String
  coachProfileId String
  contenu        String
  note           Int          @default(3) // 1 à 5
  createdAt      DateTime     @default(now())
  learner        Learner      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  coach          CoachProfile @relation(fields: [coachProfileId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  payload   String?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Avis {
  id             String       @id @default(uuid())
  coachProfileId String
  missionId      String?      @unique // un avis par mission
  auteurNom      String?
  note           Int
  commentaire    String?
  createdAt      DateTime     @default(now())
  coach          CoachProfile @relation(fields: [coachProfileId], references: [id])
}

// ═══════════ Moteur d'abonnement, parrainage & rétrocessions ═══════════
// Voir docs/MOTEUR-ABONNEMENT-PARRAINAGE.md. Toutes les règles financières
// sont appliquées côté serveur (services/finance/*) à partir d'une politique
// VERSIONNÉE : un changement de paramètres ne modifie jamais le passé.

// Politique commerciale versionnée (§2) — les montants des transactions sont
// FIGÉS au moment de leur création ; la politique sert aux nouveaux calculs.
model ReferralPolicy {
  id                       String   @id @default(uuid())
  version                  Int      @unique
  basePriceRef             Int // tarif facial de référence (FCFA) — informatif
  discountRate             Int // % réduction des premiers filleuls
  commissionRate           Int // % rétrocession du parrain
  discountedReferralsLimit Int // nb de places promotionnelles
  minimumNetCost           Int // plancher du coût économique net (FCFA)
  referralDepth            Int      @default(1) // strictement direct
  slotTtlHeures            Int      @default(72) // durée de réservation d'une place promo
  payoutMinimum            Int      @default(1000) // versement minimum (FCFA)
  payoutDelaiJours         Int      @default(0) // délai de sécurité avant disponibilité
  payoutLimiteJour         Int? // plafond de versement / jour / utilisateur
  payoutLimiteMois         Int? // plafond de versement / mois / utilisateur
  rarCibleMoyen            Int      @default(8500) // cible de pilotage (§22)
  rarSeuilOrangePct        Int      @default(95) // sous ce % de la cible → orange
  alertes                  String? // JSON : seuils du moteur d'alertes (§30)
  messagesPartage          String? // JSON : messages de partage administrables (§18)
  actif                    Boolean  @default(true)
  effectiveFrom            DateTime @default(now())
  createdById              String?
  createdAt                DateTime @default(now())

  subscriptions Subscription[]
}

// Une ligne PAR PÉRIODE d'abonnement (l'accès Formation reste FormationEnrollment,
// qui pointe vers sa période courante via subscriptionId)
model Subscription {
  id             String    @id @default(uuid())
  userId         String
  planId         String? // FormationOffre choisie
  policyId       String // politique en vigueur à la souscription (figée)
  referralId     String?   @unique // attribution de parrainage à l'origine (si filleul)
  prixFacial     Int
  reduction      Int       @default(0) // réduction parrainage OU promo (non cumulables)
  sourceReduction String? // 'parrainage' | 'promo:<CODE>' | null
  montantPaye    Int
  operateur      String?
  refTransaction String?
  statut         String    @default("pending") // pending | active | expired | cancelled | refunded
  startedAt      DateTime?
  expiresAt      DateTime?
  idempotencyKey String    @unique // ex. ENR:<enrollmentId>:<n>
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User            @relation(fields: [userId], references: [id])
  plan   FormationOffre? @relation(fields: [planId], references: [id])
  policy ReferralPolicy  @relation(fields: [policyId], references: [id])

  @@index([userId, statut])
}

// Attribution filleul → parrain pour le moteur (complète User.referredById sans le casser)
model ReferralAttribution {
  id             String    @id @default(uuid())
  parrainUserId  String
  filleulUserId  String    @unique // un filleul n'a qu'UN parrain (strictement direct §10)
  codeUtilise    String
  statut         String    @default("inscrit") // inscrit | paye | valide | rejete | fraude
  subscriptionId String?   @unique
  slotRang       Int? // 1..limit si place promotionnelle consommée
  validatedAt    DateTime?
  createdAt      DateTime  @default(now())

  parrain User @relation("AttributionsParrain", fields: [parrainUserId], references: [id])
  filleul User @relation("AttributionFilleul", fields: [filleulUserId], references: [id])

  @@index([parrainUserId, statut])
}

// Les places promotionnelles d'un parrain (§12) — « jamais plus de N » garanti
// par la contrainte unique (parrain, rang) + réservation TTL
model ReferralPromotionSlot {
  id            String    @id @default(uuid())
  parrainUserId String
  rang          Int // 1..discountedReferralsLimit
  statut        String    @default("reserve") // reserve | confirme | expire | libere
  filleulUserId String?
  reservedAt    DateTime  @default(now())
  expiresAt     DateTime // fin de la réservation (TTL)
  confirmedAt   DateTime?

  parrain User @relation("SlotsParrain", fields: [parrainUserId], references: [id])

  @@unique([parrainUserId, rang])
  @@index([statut, expiresAt])
}

// Portefeuille financier (§13) — CACHE dénormalisé ; la source de vérité est le ledger
model FinancialWallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  acquis        Int      @default(0) // rétrocessions totales acquises (validées)
  disponible    Int      @default(0) // disponibles pour versement
  enAttente     Int      @default(0) // payout demandé / en traitement
  verse         Int      @default(0) // déjà versées
  moyenPaiement String? // wave | orange | mtn | moov | virement
  numeroPaiement String? // coordonnées bénéficiaire
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// LEDGER FINANCIER IMMUABLE (§14) — aucune suppression ; corrections par contre-écriture
model FinancialLedgerEntry {
  id              String   @id @default(uuid())
  userId          String // bénéficiaire (parrain) ou concerné
  type            String // REFERRAL_COMMISSION_CREATED | _VALIDATED | _AVAILABLE | PAYOUT_REQUESTED | PAYOUT_PROCESSING | PAYOUT_COMPLETED | PAYOUT_FAILED | REFERRAL_COMMISSION_CANCELLED | COMMISSION_REVERSED | REFUND_ADJUSTMENT | MANUAL_ADJUSTMENT
  montant         Int // signé (FCFA) : + crédit, − débit/contre-écriture
  devise          String   @default("XOF")
  taux            Int? // taux appliqué (%) le cas échéant
  filleulSourceId String? // filleul à l'origine de la rétrocession
  subscriptionId  String? // abonnement source
  payoutId        String?
  referenceExterne String? // réf. mobile money du versement, etc.
  statut          String   @default("comptabilise")
  motif           String?
  creePar         String // userId admin ou 'system'
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([subscriptionId])
}

// Versements des rétrocessions (§15)
model Payout {
  id               String    @id @default(uuid())
  userId           String
  montant          Int
  frais            Int       @default(0)
  moyen            String // wave | orange | mtn | moov | virement
  numeroBeneficiaire String
  statut           String    @default("requested") // requested | processing | paid | failed | cancelled
  requestedAt      DateTime  @default(now())
  processedAt      DateTime?
  processedById    String?
  referenceExterne String?
  motifEchec       String?

  user User @relation(fields: [userId], references: [id])

  @@index([statut])
  @@index([userId])
}

// Signaux antifraude (§31)
model FraudFlag {
  id           String    @id @default(uuid())
  userId       String
  type         String // auto_parrainage | multi_comptes | meme_numero_versement | meme_ref_transaction | rythme_anormal | remboursement_apres_commission | autre
  severite     String    @default("info") // info | moyen | eleve
  detail       String? // JSON
  statut       String    @default("REVIEW") // REVIEW | NORMAL | SUSPICIOUS | BLOCKED (décision)
  createdAt    DateTime  @default(now())
  resolvedById String?
  resolvedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([statut])
  @@index([userId])
}

// Journal d'audit des actions sensibles (§42.11-12)
model AuditLog {
  id        String   @id @default(uuid())
  acteurId  String? // null = système
  action    String // ex. policy.update, payout.paid, enrollment.valider, adjustment.manual
  cibleType String?
  cibleId   String?
  avant     String? // JSON
  apres     String? // JSON
  createdAt DateTime @default(now())

  @@index([action])
  @@index([cibleType, cibleId])
}

// Photo quotidienne des indicateurs (§20-§25, §30) — calculée par cron
model ProfitabilitySnapshot {
  id                  String   @id @default(uuid())
  jour                DateTime @unique // date (minuit UTC)
  caFacial            Int      @default(0)
  encaissements       Int      @default(0)
  reductions          Int      @default(0)
  retroAcquises       Int      @default(0)
  retroPayees         Int      @default(0)
  engagementsRestants Int      @default(0) // rétrocessions dues non versées
  rar                 Int      @default(0)
  rarMoyen            Int      @default(0)
  margeContributive   Int      @default(0)
  referralCac         Int      @default(0)
  coefK               Float    @default(0)
  abonnesActifs       Int      @default(0)
  nouveauxAbonnes     Int      @default(0)
  detail              String? // JSON : décomposition + alertes déclenchées
  createdAt           DateTime @default(now())
}

// Scénarios du simulateur de rentabilité (§26-§28)
model ProfitabilityScenario {
  id          String   @id @default(uuid())
  nom         String
  params      String // JSON
  resultats   String? // JSON (derniers résultats calculés)
  predefini   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Fonction Publique : maîtrise par article (répétition espacée §10) ───
// Modèle autonome (pas de relation Prisma vers User pour ne pas toucher au
// modèle existant) ; nettoyé explicitement à la suppression d'un compte.
model FpMastery {
  id          String    @id @default(uuid())
  userId      String
  article     Int // 1-116
  score       Int       @default(0) // 0-100
  bonnes      Int       @default(0)
  erreurs     Int       @default(0)
  intervalIdx Int       @default(0) // position dans l'échelle J0-J1-J3-J7-J14-J30
  nextReview  DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, article])
  @@index([userId, nextReview])
}

// ─── Fonction Publique : gamification (§9 — XP, badges, série) ───
model FpGamif {
  userId          String    @id
  xp              Int       @default(0)
  serieJours      Int       @default(0)
  dernierJourActif DateTime?
  xpJour          Int       @default(0) // plafond quotidien anti-abus
  jourXp          DateTime?
  partiesJouees   Int       @default(0)
  badges          String    @default("[]") // JSON
  updatedAt       DateTime  @updatedAt
}
